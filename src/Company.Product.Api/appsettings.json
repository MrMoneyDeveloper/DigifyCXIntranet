{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionStringName": "SqlServer",
    "RunMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=CompanyProductDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Authentication": {
    "Jwt": {
      "Authority": "https://login.microsoftonline.com/common/v2.0",
      "Audience": "api://company-product",
      "RequireHttpsMetadata": true,
      "ScopeClaimType": "scope"
    }
  }
}
