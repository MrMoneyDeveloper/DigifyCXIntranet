@inject DigifyCXIntranet.Services.IAdminAccessService AdminAccess
@{
    var role = AdminAccess.GetPrimaryRole(User);
}

<ul class="dcx-usernav">

    @if (User?.Identity?.IsAuthenticated != true)
    {
        <li>
            <a asp-page="/Account/Login" class="dcx-btn dcx-usernav__signin">
                Sign In
            </a>
        </li>
    }
    else if (AdminAccess.IsAdmin(User))
    {
        <li>
            <a asp-page="/Profile/Index"
               title="Manage Admin Profile"
               class="dcx-usernav__role dcx-usernav__role--admin">
                @role
            </a>
        </li>
        <li>
            <form method="post" asp-page="/Account/Logout" asp-route-returnUrl="/Account/Login" class="m-0 p-0 flex">
                <button type="submit" class="dcx-usernav__signout">
                    Sign Out
                </button>
            </form>
        </li>
    }
    else
    {
        <li>
            <a asp-page="/Profile/Index"
               title="Manage Profile"
               class="dcx-usernav__role dcx-usernav__role--employee">
                @role
            </a>
        </li>
        <li>
            <form method="post" asp-page="/Account/Logout" asp-route-returnUrl="/Account/Login" class="m-0 p-0 flex">
                <button type="submit" class="dcx-usernav__signout">
                    Sign Out
                </button>
            </form>
        </li>
    }
</ul>