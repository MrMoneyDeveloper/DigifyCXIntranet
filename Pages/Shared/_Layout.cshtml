@{
    var path = Context?.Request?.Path.Value?.TrimEnd('/') ?? string.Empty;
    var isAuthPage =
        path.Equals("/Account/Login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/Account/Register", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/Account/SignUp", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/Identity/Account/Login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/Identity/Account/Register", StringComparison.OrdinalIgnoreCase);

    bool IsCurrentPage(string target)
    {
        var route = target.EndsWith("/Index", StringComparison.OrdinalIgnoreCase)
            ? target[..^6]
            : target;
        return path.Equals(target, StringComparison.OrdinalIgnoreCase) ||
               path.Equals(route, StringComparison.OrdinalIgnoreCase);
    }

    string NavState(string target) => IsCurrentPage(target) ? "nav-link-soft active" : "nav-link-soft";
    string? NavCurrent(string target) => IsCurrentPage(target) ? "page" : null;
}
@inject DigifyCXIntranet.Services.IAdminAccessService NavAdminAccess
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DigifyCX Employee Platform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tailwind.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="dcx-shell min-h-screen antialiased flex flex-col">
    <a class="dcx-skip-link" href="#main-content">Skip to main content</a>
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden bg-[radial-gradient(circle_at_top_left,_rgba(132,220,215,0.12),_transparent_22%),linear-gradient(180deg,_#11182a_0%,_#171d31_44%,_#0e1422_100%)]">
        <div class="absolute inset-0 opacity-[0.16]" style="background-image: linear-gradient(rgba(132,220,215,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(132,220,215,.12) 1px, transparent 1px); background-size: 72px 72px;"></div>
        <div class="absolute -left-24 top-8 h-72 w-72 rounded-full bg-cyan-400/20 blur-3xl animate-bob"></div>
        <div class="absolute -right-24 top-16 h-80 w-80 rounded-full bg-teal-300/10 blur-3xl animate-bob" style="animation-delay: 1.2s"></div>
    </div>

    <header class="app-brand-header sticky top-0 z-40 pt-4">
        <div class="mx-auto max-w-7xl px-4 lg:px-6">
            <div class="dcx-header">
                <nav class="flex flex-wrap items-center justify-between gap-4 px-4 py-3 lg:px-6" aria-label="Main navigation">
                    <a class="dcx-brand" asp-area="" asp-page="/Index">
                        <img src="~/images/branding/digifycx-logo.png"
                             alt="DigifyCX logo"
                             width="44"
                             height="44" />
                        <span class="dcx-brand-wordmark">digifyCX</span>
                    </a>

                    <ul class="dcx-nav m-0 list-none p-0">
                        <li><a class="@NavState("/Index")" aria-current="@NavCurrent("/Index")" asp-page="/Index">Home</a></li>
                        <li><a class="@NavState("/Canteen/Index")" aria-current="@NavCurrent("/Canteen/Index")" asp-page="/Canteen/Index">Canteen</a></li>
                        <li>
                            <a class="@NavState("/Announcements/Index")" aria-current="@NavCurrent("/Announcements/Index")"
                               asp-page="/Announcements/Index">
                                What's New?
                            </a>
                        </li>
                        <li><a class="@NavState("/Jobs/Index")" aria-current="@NavCurrent("/Jobs/Index")" asp-page="/Jobs/Index">Job Postings</a></li>
                        <li><a class="@NavState("/Policies/Index")" aria-current="@NavCurrent("/Policies/Index")" asp-page="/Policies/Index">Policies</a></li>
                        <li><a class="@NavState("/Faq/Index")" aria-current="@NavCurrent("/Faq/Index")" asp-page="/Faq/Index">FAQ</a></li>
                    </ul>

                    <div class="flex-shrink-0">
                        <partial name="_LoginPartial" />
                    </div>
                </nav>
            </div>
        </div>

        @if (User?.Identity?.IsAuthenticated == true)
        {
            <div class="app-quickbar">
                <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-2 px-4 py-2 lg:px-6">

                    @if (NavAdminAccess.IsAdmin(User))
                    {
                        <span class="mr-2 text-[10px] font-bold uppercase tracking-widest text-amber-300/80">Admin Actions</span>

                        <a asp-page="/Admin/Index"
                           class="inline-flex items-center gap-1.5 rounded-full bg-amber-400 px-4 py-1.5 text-xs font-bold text-slate-950 shadow-md transition hover:bg-amber-300 hover:shadow-amber-300/30">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                            Admin Console
                        </a>

                        @if (User.IsInRole(DigifyCXIntranet.Services.AppRoles.HrAdmin))
                        {
                            <a asp-page="/Admin/Announcements"
                               class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-400/10 px-4 py-1.5 text-xs font-bold text-amber-200 transition hover:border-amber-300 hover:bg-amber-400/20">
                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
                                Manage Announcements
                            </a>
                        }

                        <a asp-page="/Jobs/Index"
                           class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-400/10 px-4 py-1.5 text-xs font-bold text-amber-200 transition hover:border-amber-300 hover:bg-amber-400/20">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2zM16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" /></svg>
                            Post / Manage Jobs
                        </a>

                        <a asp-page="/Policies/Index"
                           class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-400/10 px-4 py-1.5 text-xs font-bold text-amber-200 transition hover:border-amber-300 hover:bg-amber-400/20">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                            Manage Policies
                        </a>
                    }
                    else
                    {
                        <span class="mr-2 text-[10px] font-bold uppercase tracking-widest text-cyan-200/80">Quick Actions</span>

                        <a asp-page="/Canteen/Index"
                           class="inline-flex items-center gap-1.5 rounded-full bg-cyan-400 px-4 py-1.5 text-xs font-bold text-slate-950 shadow-md transition hover:bg-cyan-300 hover:shadow-cyan-300/30">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h18M3 3v4a9 9 0 009 9 9 9 0 009-9V3M12 15v6" /></svg>
                            Submit Canteen Request
                        </a>

                        <a asp-page="/Jobs/Index"
                           class="inline-flex items-center gap-1.5 rounded-full border border-cyan-400/40 bg-cyan-400/10 px-4 py-1.5 text-xs font-bold text-cyan-100 transition hover:border-cyan-300 hover:bg-cyan-400/20">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2zM16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" /></svg>
                            Browse Open Jobs
                        </a>

                        <a asp-page="/Faq/Index"
                           class="inline-flex items-center gap-1.5 rounded-full border border-cyan-400/40 bg-cyan-400/10 px-4 py-1.5 text-xs font-bold text-cyan-100 transition hover:border-cyan-300 hover:bg-cyan-400/20">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path stroke-linecap="round" stroke-linejoin="round" d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3M12 17h.01" /></svg>
                            Read FAQs
                        </a>

                        <a asp-page="/Policies/Index"
                           class="inline-flex items-center gap-1.5 rounded-full border border-cyan-400/40 bg-cyan-400/10 px-4 py-1.5 text-xs font-bold text-cyan-100 transition hover:border-cyan-300 hover:bg-cyan-400/20">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                            View Policies
                        </a>
                    }

                </div>
            </div>
        }
    </header>

    <main id="main-content" tabindex="-1" class="app-main mx-auto w-full max-w-7xl px-4 lg:px-6 animate-reveal flex-grow">
        @RenderBody()
    </main>

    <footer class="app-brand-footer mt-auto w-full text-sm">
        <div class="app-footer-inner mx-auto max-w-7xl px-4 lg:px-6">
            <img class="app-footer-building" src="~/images/branding/footer-building.png" alt="" aria-hidden="true" width="66" height="66" loading="lazy" decoding="async" />
            <dl class="app-footer-details">
                <dt>Company</dt>
                <dd>Digify CX</dd>
                <dt>Address</dt>
                <dd>1 Umhlanga Ridge Boulevard lunar Umhlanga New Town Centre, Umhlanga, 4319</dd>
            </dl>
            <div class="app-footer-logo flex items-center gap-3">
                <img src="~/images/branding/digifycx-logo.png"
                     alt="DigifyCX logo"
                     class="h-10 w-10 object-contain"
                     width="40"
                     height="40" />
                <span>digifyCX</span>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (!isAuthPage && User?.Identity?.IsAuthenticated == true)
    {
        <link rel="preconnect" href="https://static.zdassets.com" crossorigin>
        <script id="ze-snippet" src="https://static.zdassets.com/ekr/snippet.js?key=12544d55-5469-4f7b-9117-eada152fadfc" defer></script>
    }
</body>
</html>
