<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DigifyCX Employee Platform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            500: "#0891b2",
                            600: "#0e7490",
                            700: "#155e75"
                        }
                    },
                    keyframes: {
                        bob: {
                            "0%, 100%": { transform: "translateY(0px)" },
                            "50%": { transform: "translateY(-6px)" }
                        },
                        reveal: {
                            "0%": { opacity: "0", transform: "translateY(14px)" },
                            "100%": { opacity: "1", transform: "translateY(0)" }
                        }
                    },
                    animation: {
                        bob: "bob 4s ease-in-out infinite",
                        reveal: "reveal 560ms ease-out both"
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DigifyCXIntranet.styles.css" asp-append-version="true" />
</head>
<body class="min-h-full bg-slate-100 text-slate-900 antialiased">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute -left-28 -top-24 h-72 w-72 rounded-full bg-cyan-300/40 blur-3xl animate-bob"></div>
        <div class="absolute -right-24 top-20 h-80 w-80 rounded-full bg-indigo-300/30 blur-3xl animate-bob" style="animation-delay: 1.2s"></div>
    </div>

    <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/80 backdrop-blur-xl">
        <nav class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 lg:px-6">
            <a class="text-lg font-extrabold tracking-tight text-slate-900 transition hover:text-brand-700" asp-area="" asp-page="/Index">
                DigifyCX
            </a>
            <ul class="flex flex-wrap items-center gap-2 text-sm font-medium text-slate-700">
                <li><a class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-brand-700" asp-page="/Index">Home</a></li>
                <li><a class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-brand-700" asp-page="/Policies/Index">Policies</a></li>
                <li><a class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-brand-700" asp-page="/Announcements/Index">Announcements</a></li>
                <li><a class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-brand-700" asp-page="/Jobs/Index">Jobs</a></li>
                <li><a class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-brand-700" asp-page="/Canteen/Index">Canteen</a></li>
                <li><a class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-brand-700" asp-page="/Faq/Index">FAQ</a></li>
                <li><a class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-brand-700" asp-page="/Profile/Index">Profile</a></li>
                <li><a class="rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-brand-700" asp-page="/Chatbot/Index">Chatbot</a></li>
            </ul>
            <partial name="_LoginPartial" />
        </nav>
    </header>

    <main role="main" class="mx-auto w-full max-w-7xl px-4 py-6 lg:px-6 animate-reveal">
        @RenderBody()
    </main>

    <footer class="mx-auto mt-8 max-w-7xl border-t border-slate-200/80 px-4 py-5 text-sm text-slate-500 lg:px-6">
        &copy; 2026 DigifyCX Internal Employee Platform
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
