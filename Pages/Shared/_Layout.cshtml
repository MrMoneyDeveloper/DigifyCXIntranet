@{
    var path = Context?.Request?.Path.Value ?? string.Empty;
    var isAuthPage =
        path.Equals("/Account/Login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/Account/Register", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/Account/SignUp", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/Identity/Account/Login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/Identity/Account/Register", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DigifyCX Employee Platform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        window.tailwind = window.tailwind || {};
        window.tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            500: "#0891b2",
                            600: "#0e7490",
                            700: "#155e75"
                        }
                    },
                    keyframes: {
                        bob: {
                            "0%, 100%": { transform: "translateY(0px)" },
                            "50%": { transform: "translateY(-6px)" }
                        },
                        reveal: {
                            "0%": { opacity: "0", transform: "translateY(14px)" },
                            "100%": { opacity: "1", transform: "translateY(0)" }
                        }
                    },
                    animation: {
                        bob: "bob 4s ease-in-out infinite",
                        reveal: "reveal 560ms ease-out both"
                    }
                }
            }
        };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DigifyCXIntranet.styles.css" asp-append-version="true" />
</head>
<body class="min-h-screen antialiased flex flex-col">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden app-bg-shell">
        <div class="app-bg-blob"></div>
    </div>
    <header class="sticky top-0 z-40 app-header">
        <nav class="app-nav mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 lg:px-6">
            <a class="brand-mark" asp-area="" asp-page="/Index">
                <img src="~/images/DigifyLogo-icon.png" alt="DigifyCX" class="brand-symbol" />
                <span class="brand-word">
                    <span class="brand-name">DigifyCX</span>
                    <span class="brand-subtitle">App1CX Portal</span>
                </span>
            </a>

            <ul class="flex flex-wrap items-center justify-center gap-3 lg:gap-5 m-0 p-0 list-none">
                <li><a class="nav-link-soft" asp-page="/Index">Home</a></li>
                <li><a class="nav-link-soft" asp-page="/Canteen/Index">Canteen</a></li>
                <li>
                    <a class="nav-link-soft nav-pill-highlight" asp-page="/Announcements/Index">What's New?</a>
                </li>
                <li><a class="nav-link-soft" asp-page="/Jobs/Index">Jobs</a></li>
                <li><a class="nav-link-soft" asp-page="/Policies/Index">Policies</a></li>
                <li><a class="nav-link-soft" asp-page="/Faq/Index">FAQ</a></li>
            </ul>

            <div class="flex-shrink-0">
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <main role="main" class="app-main mx-auto w-full max-w-7xl px-4 lg:px-6 animate-reveal flex-grow">
        @RenderBody()
    </main>

    <footer class="mt-auto w-full px-4 py-5 text-sm text-slate-500 text-center">
        &copy; 2026 App1CX / Digify BPO Employee Portal
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (!isAuthPage && User?.Identity?.IsAuthenticated == true)
    {
        <link rel="preconnect" href="https://static.zdassets.com" crossorigin>
        <!-- Start of cxe-internal Zendesk Widget script -->
        <script id="ze-snippet" src="https://static.zdassets.com/ekr/snippet.js?key=12544d55-5469-4f7b-9117-eada152fadfc" defer></script>
        <!-- End of cxe-internal Zendesk Widget script -->
    }
</body>
</html>
