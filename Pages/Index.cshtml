@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-panel hero-home mb-4 animate-card">
    <div class="hero-home-grid">
        <div class="hero-home-content">
            <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-4">
                <div>
                    <div class="page-kicker mb-3">Employee Platform</div>
                    <h1 class="page-title">Welcome back, <span>@Model.DisplayName</span></h1>
                    <p class="page-copy mt-3 mb-0">A focused hub for business notices, HR openings, Zendesk-backed policies, canteen services, and employee self-service.</p>
                </div>
                <div class="meta-pill">@Model.RoleName</div>
            </div>

            <div class="metric-grid mt-4">
                <div class="metric-card">
                    <div class="metric-label">Canteen spend this month</div>
                    <div class="metric-value">R @Model.CurrentMonthCanteenTotal.ToString("N2")</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Recent internal openings</div>
                    <div class="metric-value">@Model.JobPostings.Count</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Policy articles available</div>
                    <div class="metric-value">@Model.PolicyCount</div>
                </div>
            </div>
        </div>

        <aside class="tech-feed-panel">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h2 class="section-title mb-1">Live Tech Feed</h2>
                    <small id="technews-updated" class="text-muted"></small>
                </div>
            </div>
            <div id="technews-loading" class="text-muted small">Loading...</div>
            <div id="technews-error" class="text-warning small d-none">Unable to load feed right now.</div>
            <div id="technews-list" class="tech-feed-list"></div>
        </aside>
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-6">
        <section class="card-elevated p-3 h-100 animate-card">
            <h2 class="h5 section-title">Pinned Announcements</h2>
            @if (Model.Announcements.Count == 0)
            {
                <p class="text-muted mb-0">No announcements available.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                @foreach (var item in Model.Announcements)
                {
                    <li class="list-group-item px-0">
                        <div class="fw-semibold">@item.Title</div>
                        <div class="small text-muted">@item.Summary</div>
                    </li>
                }
                </ul>
            }
            <a asp-page="/Announcements/Index" class="btn btn-sm btn-outline-primary mt-3">View All</a>
        </section>
    </div>
    <div class="col-lg-6">
        <section class="card-elevated p-3 h-100 animate-card">
            <h2 class="h5 section-title">Latest Policies &amp; Procedures</h2>
            @if (Model.Policies.Count == 0)
            {
                <p class="text-muted mb-0">No active documents available.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                @foreach (var item in Model.Policies)
                {
                    <li class="list-group-item px-0">
                        <div class="fw-semibold">@item.Title</div>
                        <div class="small text-muted">@item.VersionLabel - Updated @item.UpdatedAtUtc.ToString("dd MMM yyyy")</div>
                    </li>
                }
                </ul>
            }
            <a asp-page="/Policies/Index" class="btn btn-sm btn-outline-primary mt-3">Browse Policies</a>
        </section>
    </div>
</div>

@section Scripts {
<script>
    (async function () {
        const loading = document.getElementById("technews-loading");
        const error = document.getElementById("technews-error");
        const list = document.getElementById("technews-list");
        const updated = document.getElementById("technews-updated");

        try {
            const response = await fetch('/api/technews', { method: 'GET' });
            if (!response.ok) throw new Error('Feed failed');
            const data = await response.json();
            loading.classList.add('d-none');

            if (data.lastUpdatedUtc) {
                const dt = new Date(data.lastUpdatedUtc);
                updated.textContent = `Updated ${dt.toLocaleString()}`;
            }

            (data.items || []).slice(0, 5).forEach(item => {
                const link = item.url && item.url.length > 0
                    ? item.url
                    : `https://news.ycombinator.com/item?id=${item.id}`;
                const card = document.createElement('a');
                card.href = link;
                card.target = "_blank";
                card.rel = "noreferrer noopener";
                card.className = "tech-feed-item";

                const title = document.createElement('span');
                title.className = "tech-feed-title";
                title.textContent = item.title || "Untitled";

                const by = document.createElement('small');
                by.className = "tech-feed-meta";
                by.textContent = `by ${item.by || "unknown"}`;

                card.appendChild(title);
                card.appendChild(by);
                list.appendChild(card);
            });
        } catch {
            loading.classList.add('d-none');
            error.classList.remove('d-none');
        }
    })();
</script>
}
