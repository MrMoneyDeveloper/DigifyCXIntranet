@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="dcx-home-hero mb-4 animate-card">
    <div class="dcx-home-hero__grid">
        <div class="dcx-home-hero__content">
            <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-4">
                <div>
                    <div class="dcx-kicker mb-3">Employee Platform</div>
                    <h1 class="dcx-home-title">Welcome back, <span>@Model.DisplayName</span></h1>
                    <p class="dcx-home-copy mt-3 mb-0">
                        A focused hub for business notices, HR openings, Zendesk-backed policies, canteen services, and employee self-service.
                    </p>
                </div>

                <div class="dcx-role-pill">@Model.RoleName</div>
            </div>

            <div class="dcx-metric-grid mt-4">
                <div class="dcx-metric-card">
                    <div class="dcx-metric-label">Canteen spend this month</div>
                    <div class="dcx-metric-value">R @Model.CurrentMonthCanteenTotal.ToString("N2")</div>
                </div>
                <div class="dcx-metric-card">
                    <div class="dcx-metric-label">Recent internal openings</div>
                    <div class="dcx-metric-value">@Model.JobPostings.Count</div>
                </div>
                <div class="dcx-metric-card">
                    <div class="dcx-metric-label">Policy articles available</div>
                    <div class="dcx-metric-value">@Model.PolicyCount</div>
                </div>
            </div>
        </div>

        <aside class="dcx-feed-panel">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h2 class="dcx-panel-title mb-1">Live Tech Feed</h2>
                    <small id="technews-updated" class="dcx-feed-meta-small"></small>
                </div>
                <img src="~/images/branding/digifycx-logo.png"
                     alt=""
                     aria-hidden="true"
                     class="dcx-feed-mark" />
            </div>

            <div id="technews-loading" class="dcx-feed-state">Loading...</div>
            <div id="technews-error" class="dcx-feed-state text-warning d-none">Unable to load feed right now.</div>
            <div id="technews-list" class="tech-feed-list"></div>
        </aside>
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-6">
        <section class="dcx-dashboard-card p-3 h-100 animate-card">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h2 class="dcx-panel-title mb-0">Pinned Announcements</h2>
                <span class="dcx-chip">Internal</span>
            </div>

            @if (Model.Announcements.Count == 0)
            {
                <p class="dcx-muted mb-0">No announcements available.</p>
            }
            else
            {
                <div class="dcx-list-stack">
                    @foreach (var item in Model.Announcements)
                    {
                        <article class="dcx-list-card">
                            <div class="dcx-list-card__title">@item.Title</div>
                            <div class="dcx-list-card__meta">@item.Summary</div>
                        </article>
                    }
                </div>
            }

            <a asp-page="/Announcements/Index" class="dcx-btn-secondary mt-3">View All</a>
        </section>
    </div>

    <div class="col-lg-6">
        <section class="dcx-dashboard-card p-3 h-100 animate-card">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h2 class="dcx-panel-title mb-0">Latest Policies &amp; Procedures</h2>
                <span class="dcx-chip">Zendesk Sync</span>
            </div>

            @if (Model.Policies.Count == 0)
            {
                <p class="dcx-muted mb-0">No active documents available.</p>
            }
            else
            {
                <div class="dcx-list-stack">
                    @foreach (var item in Model.Policies)
                    {
                        <article class="dcx-list-card">
                            <div class="dcx-list-card__title">@item.Title</div>
                            <div class="dcx-list-card__meta">@item.VersionLabel - Updated @item.UpdatedAtUtc.ToString("dd MMM yyyy")</div>
                        </article>
                    }
                </div>
            }

            <a asp-page="/Policies/Index" class="dcx-btn-secondary mt-3">Browse Policies</a>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (async function () {
            const loading = document.getElementById("technews-loading");
            const error = document.getElementById("technews-error");
            const list = document.getElementById("technews-list");
            const updated = document.getElementById("technews-updated");

            try {
                const response = await fetch('/api/technews', { method: 'GET' });
                if (!response.ok) throw new Error('Feed failed');
                const data = await response.json();
                loading.classList.add('d-none');

                if (data.lastUpdatedUtc) {
                    const dt = new Date(data.lastUpdatedUtc);
                    updated.textContent = `Updated ${dt.toLocaleString()}`;
                }

                (data.items || []).slice(0, 5).forEach(item => {
                    const link = item.url && item.url.length > 0
                        ? item.url
                        : `https://news.ycombinator.com/item?id=${item.id}`;
                    const card = document.createElement('a');
                    card.href = link;
                    card.target = "_blank";
                    card.rel = "noreferrer noopener";
                    card.className = "tech-feed-item";

                    const title = document.createElement('span');
                    title.className = "tech-feed-title";
                    title.textContent = item.title || "Untitled";

                    const by = document.createElement('small');
                    by.className = "tech-feed-meta";
                    by.textContent = `by ${item.by || "unknown"}`;

                    card.appendChild(title);
                    card.appendChild(by);
                    list.appendChild(card);
                });
            } catch {
                loading.classList.add('d-none');
                error.classList.remove('d-none');
            }
        })();
    </script>
}