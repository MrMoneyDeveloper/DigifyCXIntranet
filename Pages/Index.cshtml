@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-panel mb-4 animate-card">
    <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-4">
        <div>
            <div class="page-kicker mb-3">Employee Platform</div>
            <h1 class="page-title">Welcome back, <span>@Model.DisplayName</span></h1>
            <p class="page-copy mt-3 mb-0">A focused hub for business notices, HR openings, Zendesk-backed policies, canteen services, and employee self-service.</p>
        </div>
        <div class="meta-pill">@Model.RoleName</div>
    </div>

    <div class="metric-grid mt-4">
        <div class="metric-card">
            <div class="metric-label">Canteen spend this month</div>
            <div class="metric-value">R @Model.CurrentMonthCanteenTotal.ToString("N2")</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Recent internal openings</div>
            <div class="metric-value">@Model.JobPostings.Count</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Policy articles available</div>
            <div class="metric-value">@Model.Policies.Count</div>
        </div>
    </div>
</section>

<div class="portal-grid-3">
    <section class="soft-card animate-card">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 class="section-title mb-0">What's New</h2>
            <a asp-page="/Announcements/Index" class="btn btn-sm btn-outline-primary">View All</a>
        </div>

        @if (Model.Announcements.Count == 0)
        {
            <p class="text-muted mb-0">No announcements available.</p>
        }
        else
        {
            foreach (var item in Model.Announcements)
            {
                <article class="list-card">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div class="list-card-title">@item.Title</div>
                        @if (item.IsPinned)
                        {
                            <span class="meta-pill">Pinned</span>
                        }
                    </div>
                    <div class="list-card-meta">@item.Summary</div>
                </article>
            }
        }
    </section>

    <section class="soft-card animate-card">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 class="section-title mb-0">Latest Policies</h2>
            <a asp-page="/Policies/Index" class="btn btn-sm btn-outline-primary">Browse</a>
        </div>

        @if (Model.Policies.Count == 0)
        {
            <p class="text-muted mb-0">No active documents available.</p>
        }
        else
        {
            foreach (var item in Model.Policies)
            {
                <a asp-page="/Policies/View" asp-route-id="@item.Id" class="list-card">
                    <div class="list-card-title">@item.Title</div>
                    <div class="list-card-meta">
                        @(string.IsNullOrWhiteSpace(item.SectionName) ? "Policy Library" : item.SectionName)
                        · Updated @item.UpdatedAtUtc.ToString("dd MMM yyyy")
                    </div>
                </a>
            }
        }
    </section>

    <aside class="soft-card animate-card">
        <h2 class="section-title">Quick Actions</h2>
        <div class="action-stack">
            <a asp-page="/Canteen/Index" class="btn btn-primary">Order From Canteen</a>
            <a asp-page="/Jobs/Index" class="btn btn-outline-primary">View Open Roles</a>
            <a asp-page="/Faq/Index" class="btn btn-outline-primary">Read FAQs</a>
            @if (Model.IsAdmin)
            {
                <a asp-page="/Admin/Index" class="btn btn-outline-primary">Admin Console</a>
            }
        </div>
    </aside>
</div>
