@page
@{
    ViewData["Title"] = "Access Denied";
}

<section class="mx-auto max-w-xl rounded-3xl border border-amber-200 bg-amber-50/80 p-8 text-center shadow-lg">
    <h1 class="text-2xl font-bold text-amber-900">Access Denied</h1>
    <p class="mt-2 text-amber-800">Your account does not have permission to access this area.</p>
    <a asp-page="/Index" class="mt-6 inline-flex rounded-xl bg-amber-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-amber-700">Return Home</a>
</section>
