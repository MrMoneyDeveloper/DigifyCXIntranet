@page
@model DigifyCXIntranet.Pages.Account.ActivateModel
@{
    ViewData["Title"] = "Activate Account";
}

<section class="mx-auto max-w-md bg-[#1e2336] rounded-2xl p-8 border border-slate-700 shadow-2xl relative overflow-hidden mt-8">
    <div class="mb-8 text-center">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Activate Your Account</h1>
        <p class="mt-2 text-sm text-slate-400">
            Enter your full name as registered by HR or a System Admin, plus the default password shared with new users.
        </p>
    </div>

    @if (Model.AlreadyActivated)
    {
        <div class="mb-6 rounded-xl border border-emerald-500/25 bg-emerald-500/10 px-4 py-4 text-sm text-emerald-400">
            <p class="font-bold text-emerald-300 mb-1">&#10003; Account Already Activated</p>
            <p>Your account has already been activated. Please log in using your personal password.</p>
        </div>
        <a href="/Account/Login"
           class="w-full inline-flex items-center justify-center rounded-xl bg-cyan-600 px-6 py-3 text-sm font-bold tracking-wide text-white shadow-sm hover:bg-cyan-500 transition-all duration-200">
            Go to Login
        </a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-5 rounded-xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-sm font-medium text-rose-400">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="space-y-5" autocomplete="off">
            @Html.AntiForgeryToken()
            @* Honeypot fields: browsers autofill these hidden inputs instead of the real ones *@
            <input type="text" name="__trap_name" style="display:none" tabindex="-1" autocomplete="username" aria-hidden="true" />
            <input type="password" name="__trap_pass" style="display:none" tabindex="-1" autocomplete="current-password" aria-hidden="true" />
            <div>
                <label asp-for="Input.FullName" class="mb-1.5 block text-sm font-semibold text-slate-300">Full Name</label>
                <input asp-for="Input.FullName"
                       class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition"
                       placeholder="e.g. Farhaan Mohamed"
                       autocomplete="off"
                       data-lpignore="true"
                       data-form-type="other" />
                <span asp-validation-for="Input.FullName" class="text-xs font-medium text-rose-400 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="Input.DefaultPassword" class="mb-1.5 block text-sm font-semibold text-slate-300">Default Password</label>
                <div class="relative">
                    <input asp-for="Input.DefaultPassword"
                           id="activate-password"
                           type="password"
                           class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-3 pr-11 text-sm text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition"
                           placeholder="Shared default password"
                           autocomplete="new-password"
                           data-lpignore="true"
                           data-form-type="other" />
                    <button type="button"
                            onclick="togglePasswordVisibility('activate-password', this)"
                            class="absolute inset-y-0 right-0 flex items-center px-3 text-slate-400 hover:text-cyan-400 transition"
                            aria-label="Toggle password visibility">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <p class="mt-1 text-xs text-slate-500">This is the shared password provided to new users. Ask your manager or a System Admin if you don&rsquo;t have it.</p>
                <span asp-validation-for="Input.DefaultPassword" class="text-xs font-medium text-rose-400 mt-1 block"></span>
            </div>
            <div class="pt-2">
                <button type="submit"
                        class="w-full inline-flex items-center justify-center rounded-xl bg-cyan-600 px-6 py-3 text-sm font-bold tracking-wide text-white shadow-sm hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all duration-200">
                    Continue &rarr;
                </button>
            </div>
        </form>
    }

    <div class="mt-6 text-center">
        <a href="/Account/Login" class="text-xs text-slate-500 hover:text-slate-300 transition">&larr; Back to login</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, btn) {
            var input = document.getElementById(inputId);
            var isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            btn.innerHTML = isHidden
                ? `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.477 0-8.268-2.943-9.542-7a9.956 9.956 0 012.293-3.95M6.228 6.228A9.956 9.956 0 0112 5c4.477 0 8.268 2.943 9.542 7a9.956 9.956 0 01-1.772 3.274M6.228 6.228L3 3m3.228 3.228l3.65 3.65M17.772 15.272l3.228 3.228m-3.228-3.228l-3.65-3.65" />
                   </svg>`
                : `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                     <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                   </svg>`;
        }
    </script>
}
