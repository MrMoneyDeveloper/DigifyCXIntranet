@page
@model DigifyCXIntranet.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Set Your Password";
}

<section class="dcx-auth-shell mt-4">
    <aside class="dcx-auth-panel">
        <img src="~/images/branding/digifycx-logo.png"
             alt="DigifyCX logo"
             class="dcx-auth-logo" />

        <div class="dcx-kicker mb-3">Account Security</div>
        <h1 class="dcx-auth-title">Set your DigifyCX password</h1>
        <p class="dcx-auth-copy mt-3">
            Choose a strong password to secure your account and complete your sign-in setup.
        </p>

        <div class="dcx-auth-feature-list mt-4">
            <div class="dcx-auth-feature">
                <span class="dcx-auth-feature__dot"></span>
                <span>Use a password you don’t reuse elsewhere</span>
            </div>
            <div class="dcx-auth-feature">
                <span class="dcx-auth-feature__dot"></span>
                <span>Make it strong enough for long-term account access</span>
            </div>
            <div class="dcx-auth-feature">
                <span class="dcx-auth-feature__dot"></span>
                <span>You’ll be signed in once the password is saved</span>
            </div>
        </div>

        <img src="~/images/branding/digifycx-logo.png"
             alt=""
             aria-hidden="true"
             class="dcx-watermark" />
    </aside>

    <section class="dcx-auth-card">
        <div class="mb-4 text-center text-md-start">
            <div class="dcx-kicker mb-3">Reset Password</div>
            <h2 class="dcx-auth-form-title">Secure your account</h2>
            <p class="dcx-auth-copy mb-0">Choose and confirm a new password to continue.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="dcx-validation-summary mb-4" role="alert" data-validation-summary>
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="dcx-form-stack">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="dcx-validation-summary" role="alert"></div>

            <input type="hidden" name="ActivationUsername" value="@Model.ActivationUsername" />

            <div>
                <label asp-for="Input.Password" for="reset-password" class="dcx-label mb-2"></label>
                <div class="dcx-password-wrap">
                    <input asp-for="Input.Password"
                           id="reset-password"
                           type="password"
                           class="dcx-input dcx-input--password"
                           placeholder="Minimum 8 characters"
                           autocomplete="new-password" />
                    <button type="button"
                            data-password-toggle="reset-password"
                            class="dcx-password-toggle"
                            aria-label="Show password">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="dcx-field-error mt-1"></span>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" for="reset-confirm-password" class="dcx-label mb-2"></label>
                <div class="dcx-password-wrap">
                    <input asp-for="Input.ConfirmPassword"
                           id="reset-confirm-password"
                           type="password"
                           class="dcx-input dcx-input--password"
                           placeholder="Re-enter your password"
                           autocomplete="new-password" />
                    <button type="button"
                            data-password-toggle="reset-confirm-password"
                            class="dcx-password-toggle"
                            aria-label="Show password">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="dcx-field-error mt-1"></span>
            </div>

            <div class="pt-2">
                <button type="submit" class="dcx-btn w-100">Save Password &amp; Sign In</button>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
