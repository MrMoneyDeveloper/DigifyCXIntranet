@page
@model DigifyCXIntranet.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Set Your Password";
}

<section class="mx-auto max-w-md bg-[#1e2336] rounded-2xl p-8 border border-slate-700 shadow-2xl relative overflow-hidden mt-8">
    <div class="mb-8 text-center">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Set Your Password</h1>
        <p class="mt-2 text-sm text-slate-400">Choose a strong password for your intranet account. You&rsquo;ll use this every time you log in.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-5 rounded-xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-sm font-medium text-rose-400">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-5 rounded-xl border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm font-medium text-emerald-400">@Model.SuccessMessage</div>
    }

    <form method="post" class="space-y-5" id="rpForm">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="Input.Email" class="mb-1.5 block text-sm font-semibold text-slate-300">Personal Email</label>
            <input asp-for="Input.Email"
                   class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition"
                   placeholder="you@gmail.com" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-xs font-medium text-rose-400 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Input.Password" class="mb-1.5 block text-sm font-semibold text-slate-300">New Password</label>
            <div class="relative">
                <input asp-for="Input.Password" id="pwField"
                       class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-3 pr-11 text-sm text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition"
                       placeholder="Minimum 8 characters" autocomplete="new-password"
                       oninput="checkStrength(this.value)" />
                <button type="button" onclick="togglePw('pwField',this)"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-200 transition"
                        aria-label="Toggle password visibility">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>
            <div class="mt-2 h-1.5 rounded-full bg-slate-700 overflow-hidden">
                <div id="strengthBar" class="h-full rounded-full transition-all duration-300" style="width:0"></div>
            </div>
            <p id="strengthLabel" class="text-xs mt-1 text-slate-500"></p>
            <ul class="mt-2 space-y-0.5 text-xs" id="reqList">
                <li id="req-len" class="text-slate-500 flex items-center gap-1"><span class="req-dot">&#9675;</span> At least 8 characters</li>
                <li id="req-upper" class="text-slate-500 flex items-center gap-1"><span class="req-dot">&#9675;</span> One uppercase letter</li>
                <li id="req-num" class="text-slate-500 flex items-center gap-1"><span class="req-dot">&#9675;</span> One number</li>
            </ul>
            <span asp-validation-for="Input.Password" class="text-xs font-medium text-rose-400 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="mb-1.5 block text-sm font-semibold text-slate-300">Confirm Password</label>
            <div class="relative">
                <input asp-for="Input.ConfirmPassword" id="cpField"
                       class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-3 pr-11 text-sm text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition"
                       placeholder="Re-enter your password" autocomplete="new-password" />
                <button type="button" onclick="togglePw('cpField',this)"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-200 transition"
                        aria-label="Toggle confirm password visibility">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-xs font-medium text-rose-400 mt-1 block"></span>
        </div>

        <div class="pt-2">
            <button type="submit" class="w-full inline-flex items-center justify-center rounded-xl bg-cyan-600 px-6 py-3 text-sm font-bold tracking-wide text-white shadow-sm hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all duration-200">
                Set Password &amp; Log In &rarr;
            </button>
        </div>
    </form>

    <div class="mt-6 text-center">
        <a href="/Account/Activate" class="text-xs text-slate-500 hover:text-slate-300 transition">&larr; Back to account activation</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePw(id, btn) {
            const el = document.getElementById(id);
            el.type = el.type === 'password' ? 'text' : 'password';
        }
        const strengthColors = ['', '#f87171', '#fb923c', '#facc15', '#22c55e'];
        const strengthLabels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
        const strengthWidths = ['0%', '25%', '50%', '75%', '100%'];
        function checkStrength(v) {
            const bar = document.getElementById('strengthBar');
            const lbl = document.getElementById('strengthLabel');
            const len = v.length >= 8;
            const upper = /[A-Z]/.test(v);
            const num = /[0-9]/.test(v);
            const long = v.length >= 12;
            const score = [len, upper, num, long].filter(Boolean).length;
            document.getElementById('req-len').className = len
                ? 'text-emerald-400 flex items-center gap-1' : 'text-slate-500 flex items-center gap-1';
            document.getElementById('req-upper').className = upper
                ? 'text-emerald-400 flex items-center gap-1' : 'text-slate-500 flex items-center gap-1';
            document.getElementById('req-num').className = num
                ? 'text-emerald-400 flex items-center gap-1' : 'text-slate-500 flex items-center gap-1';
            bar.style.width = v.length ? strengthWidths[score] : '0';
            bar.style.background = strengthColors[score] || 'transparent';
            lbl.textContent = v.length ? strengthLabels[score] : '';
            lbl.style.color = strengthColors[score] || '';
        }
    </script>
}
