@page
@model DigifyCXIntranet.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="dcx-auth-shell mt-4">
    <aside class="dcx-auth-panel">
        <img src="~/images/branding/digifycx-logo.png"
             alt="DigifyCX logo"
             class="dcx-auth-logo" />

        <div class="dcx-kicker mb-3">Password Recovery</div>
        <h1 class="dcx-auth-title">Raise a support request to regain access</h1>
        <p class="dcx-auth-copy mt-3">
            If you’ve forgotten your password, submit your full name and the system will raise an IT support ticket for review and reset handling.
        </p>

        <div class="dcx-auth-feature-list mt-4">
            <div class="dcx-auth-feature">
                <span class="dcx-auth-feature__dot"></span>
                <span>Support requests are routed through Zendesk</span>
            </div>
            <div class="dcx-auth-feature">
                <span class="dcx-auth-feature__dot"></span>
                <span>Your IT team can verify and process the reset</span>
            </div>
            <div class="dcx-auth-feature">
                <span class="dcx-auth-feature__dot"></span>
                <span>Once approved, you can return and re-enter the activation flow</span>
            </div>
        </div>

        <img src="~/images/branding/digifycx-logo.png"
             alt=""
             aria-hidden="true"
             class="dcx-watermark" />
    </aside>

    <section class="dcx-auth-card">
        <div class="mb-4 text-center text-md-start">
            <div class="dcx-kicker mb-3">Forgot Password</div>
            <h2 class="dcx-auth-form-title">Get help from IT support</h2>
            <p class="dcx-auth-copy mb-0">Enter the name you use on the intranet and we’ll raise a support request.</p>
        </div>

        @if (Model.Submitted)
        {
            @if (Model.Succeeded)
            {
                <div class="dcx-inline-alert dcx-inline-alert--success text-center">
                    <div class="dcx-status-icon mx-auto mb-3">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                    </div>
                    <p class="fw-bold mb-1">Support ticket raised</p>
                    <p class="mb-1">Your IT team has been notified and will assist you shortly.</p>

                    @if (Model.TicketId.HasValue)
                    {
                        <p class="mb-0 mt-2">
                            Ticket reference:
                            <span class="dcx-ticket-ref">#@Model.TicketId</span>
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="dcx-validation-summary">
                    <p class="fw-bold mb-1">Could not raise ticket</p>
                    <p class="mb-1">@Model.ErrorMessage</p>
                    <p class="mb-0">Please contact IT support directly or try again.</p>
                </div>
            }

            <div class="mt-4 text-center text-md-start">
                <a href="/Account/Login" class="dcx-text-link">&larr; Back to Sign In</a>
            </div>
        }
        else
        {
            <div asp-validation-summary="ModelOnly" class="dcx-validation-summary mb-4"></div>

            <form method="post" class="dcx-form-stack">
                <div>
                    <label asp-for="Input.FullName" class="dcx-label mb-2">Full Name</label>
                    <input asp-for="Input.FullName"
                           placeholder="e.g. Jane Smith"
                           class="dcx-input" />
                    <span asp-validation-for="Input.FullName" class="dcx-field-error mt-1"></span>
                    <p class="mt-2 mb-0 dcx-helper-text">Enter the name you use to log into the intranet.</p>
                </div>

                <div class="dcx-info-panel">
                    <p class="mb-0">
                        <svg class="dcx-info-panel__icon" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                        </svg>
                        An IT support ticket will be raised automatically with your device IP address and current timestamp so support can assist with verification.
                    </p>
                </div>

                <div class="pt-2">
                    <button type="submit" class="dcx-btn w-100">
                        Raise Support Ticket
                    </button>
                </div>
            </form>

            <div class="mt-4 text-center text-md-start">
                <a href="/Account/Login" class="dcx-text-link">&larr; Back to Sign In</a>
            </div>
        }
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}