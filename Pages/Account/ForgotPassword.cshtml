@page
@model DigifyCXIntranet.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="mx-auto max-w-md bg-[#1e2336] rounded-2xl p-8 border border-slate-700 shadow-2xl relative overflow-hidden mt-8">
    <div class="mb-8 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-cyan-600/10 ring-1 ring-cyan-600/30">
            <svg class="h-7 w-7 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 0 1 21.75 8.25Z" />
            </svg>
        </div>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Forgot Password?</h1>
        <p class="mt-2 text-sm text-slate-400">Enter your name and we'll raise an IT support ticket to get you back in.</p>
    </div>

    @if (Model.Submitted)
    {
        @if (Model.Succeeded)
        {
            <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-5 py-4 text-center">
                <svg class="mx-auto mb-3 h-8 w-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <p class="text-sm font-semibold text-emerald-300">Support ticket raised!</p>
                <p class="mt-1 text-xs text-slate-400">Your IT team has been notified and will assist you shortly.</p>
                @if (Model.TicketId.HasValue)
                {
                    <p class="mt-2 text-xs text-slate-500">Ticket reference: <span class="font-mono text-cyan-400">#@Model.TicketId</span></p>
                }
            </div>
        }
        else
        {
            <div class="rounded-xl border border-rose-500/20 bg-rose-500/10 px-5 py-4 text-sm text-rose-400">
                <p class="font-semibold">Could not raise ticket</p>
                <p class="mt-1 text-xs">@Model.ErrorMessage</p>
                <p class="mt-2 text-xs text-slate-500">Please contact IT support directly or try again.</p>
            </div>
        }
        <div class="mt-6 text-center">
            <a href="/Account/Login" class="text-sm text-cyan-400 hover:text-cyan-300 transition">&larr; Back to Sign In</a>
        </div>
    }
    else
    {
        <div asp-validation-summary="ModelOnly" class="mb-5 rounded-xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-sm font-medium text-rose-400"></div>

        <form method="post" class="space-y-5">
            <div>
                <label asp-for="Input.FullName" class="mb-1.5 block text-sm font-semibold text-slate-300">Full Name</label>
                <input asp-for="Input.FullName"
                       placeholder="e.g. Jane Smith"
                       class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition" />
                <span asp-validation-for="Input.FullName" class="text-xs font-medium text-rose-400 mt-1 block"></span>
                <p class="mt-1 text-xs text-slate-500">Enter the name you use to log into the intranet.</p>
            </div>

            <div class="rounded-lg border border-slate-700/60 bg-slate-800/30 px-4 py-3">
                <p class="text-xs font-medium text-slate-400">
                    <svg class="inline-block h-3.5 w-3.5 text-cyan-400 mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                    </svg>
                    An IT support ticket will be raised automatically with your device's IP address and the current timestamp so IT can locate you on the company floor.
                </p>
            </div>

            <div class="pt-2">
                <button type="submit"
                        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-600 px-6 py-3 text-sm font-bold tracking-wide text-white shadow-sm hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all duration-200">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                    </svg>
                    Raise Support Ticket
                </button>
            </div>
        </form>

        <div class="mt-5 text-center">
            <a href="/Account/Login" class="text-xs text-slate-500 hover:text-cyan-400 transition">&larr; Back to Sign In</a>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
