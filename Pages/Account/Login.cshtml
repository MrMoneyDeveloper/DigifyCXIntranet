@page
@model DigifyCXIntranet.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<section class="dcx-auth-shell mt-4">
    <aside class="dcx-auth-panel">
        <img src="~/images/branding/digifycx-logo.png"
             alt="DigifyCX logo"
             class="dcx-auth-logo" />

        <div class="dcx-kicker mb-3">Secure Access</div>
        <h1 class="dcx-auth-title">Welcome back to the DigifyCX intranet</h1>
        <p class="dcx-auth-copy mt-3">
            Sign in to access announcements, policies, internal opportunities, canteen services, and employee self-service tools.
        </p>

        <div class="dcx-auth-feature-list mt-4">
            <div class="dcx-auth-feature">
                <span class="dcx-auth-feature__dot"></span>
                <span>Fast access to internal tools and updates</span>
            </div>
            <div class="dcx-auth-feature">
                <span class="dcx-auth-feature__dot"></span>
                <span>Zendesk-backed support and policy workflows</span>
            </div>
            <div class="dcx-auth-feature">
                <span class="dcx-auth-feature__dot"></span>
                <span>Designed for employees, HR, and admin teams</span>
            </div>
        </div>

        <img src="~/images/branding/digifycx-logo.png"
             alt=""
             aria-hidden="true"
             class="dcx-watermark" />
    </aside>

    <section class="dcx-auth-card">
        <div class="mb-4 text-center text-md-start">
            <div class="dcx-kicker mb-3">Sign In</div>
            <h2 class="dcx-auth-form-title">Access your account</h2>
            <p class="dcx-auth-copy mb-0">Use your DigifyCX intranet credentials to continue.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="dcx-validation-summary mb-4" role="alert"></div>

        @if (Model.ShowForgotPasswordPrompt)
        {
            var forgotUrl = "/Account/ForgotPassword";
            if (!string.IsNullOrWhiteSpace(Model.FailedUsername))
            {
                forgotUrl += "?name=" + Uri.EscapeDataString(Model.FailedUsername);
            }

            <div class="dcx-inline-alert dcx-inline-alert--warning mb-4">
                <p class="fw-bold mb-1">Incorrect Password</p>
                <p class="mb-3">
                    The password you entered doesn&rsquo;t match our records. If you&rsquo;ve forgotten it, request a reset through IT support.
                </p>
                <a href="@forgotUrl" class="dcx-btn">Request a Password Reset</a>
            </div>
        }

        <form method="post" class="dcx-form-stack">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <div>
                <label asp-for="Input.Username" class="dcx-label mb-2"></label>
                <input asp-for="Input.Username" class="dcx-input" autocomplete="username" autocapitalize="none" spellcheck="false" />
                <span asp-validation-for="Input.Username" class="dcx-field-error mt-1"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="dcx-label mb-2"></label>
                <div class="dcx-password-wrap">
                    <input asp-for="Input.Password"
                           type="password"
                           autocomplete="current-password"
                           class="dcx-input dcx-input--password" />
                    <button type="button"
                            data-password-toggle="Input_Password"
                            class="dcx-password-toggle"
                            aria-label="Show password">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="dcx-field-error mt-1"></span>
            </div>

            <div class="pt-2">
                <button type="submit" class="dcx-btn w-100">Sign In</button>
            </div>
        </form>

        <div class="mt-4 text-center text-md-start">
            <a href="/Account/Activate" class="dcx-text-link">First time here? Activate your account</a>
        </div>

        @if (Model.ShowDemoCredentials && Model.DemoUsers.Count > 0)
        {
            <div class="dcx-dev-credentials mt-4">
                <p class="dcx-dev-credentials__title">Configured dev credentials</p>
                <div class="table-responsive">
                    <table class="table mb-0 align-middle dcx-dev-table">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Password</th>
                                <th>Role</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.DemoUsers)
                            {
                                <tr>
                                    <td><code>@user.Username</code></td>
                                    <td><code>@user.Password</code></td>
                                    <td><code>@user.Role</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
