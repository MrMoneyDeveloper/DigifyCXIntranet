@page
@model DigifyCXIntranet.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<section class="mx-auto max-w-md bg-[#1e2336] rounded-2xl p-8 border border-slate-700 shadow-2xl relative overflow-hidden mt-8">
    <div class="mb-8 text-center">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Welcome Back</h1>
        <p class="mt-2 text-sm text-slate-400">Sign in to access the DigifyCX Intranet.</p>
    </div>

    @* Validation summary for generic errors (account not found, not activated, etc.) *@
    <div asp-validation-summary="ModelOnly" class="mb-5 rounded-xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-sm font-medium text-rose-400"></div>

    @* ── Prominent Forgot Password banner shown only on wrong-password errors ── *@
    @if (Model.ShowForgotPasswordPrompt)
    {
        var forgotUrl = "/Account/ForgotPassword";
        if (!string.IsNullOrWhiteSpace(Model.FailedUsername))
        {
            forgotUrl += "?name=" + Uri.EscapeDataString(Model.FailedUsername);
        }
        <div class="mb-5 rounded-xl border border-amber-500/25 bg-amber-500/10 px-4 py-4 text-sm">
            <p class="font-bold text-amber-300 mb-1">&#128274; Incorrect Password</p>
            <p class="text-amber-200/80 mb-3">
                The password you entered doesn&rsquo;t match our records.
                If you&rsquo;ve forgotten your password, IT support can help.
            </p>
            <a href="@forgotUrl"
               class="inline-flex items-center justify-center rounded-lg bg-amber-500 px-4 py-2 text-xs font-bold text-slate-900 hover:bg-amber-400 transition-all duration-200">
                Request a Password Reset &rarr;
            </a>
        </div>
    }

    <form method="post" class="space-y-5">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div>
            <label asp-for="Input.Username" class="mb-1.5 block text-sm font-semibold text-slate-300"></label>
            <input asp-for="Input.Username"
                   class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition" />
            <span asp-validation-for="Input.Username" class="text-xs font-medium text-rose-400 mt-1 block"></span>
        </div>
        <div>
            <label asp-for="Input.Password" class="mb-1.5 block text-sm font-semibold text-slate-300"></label>
            <div class="relative">
                <input asp-for="Input.Password"
                       id="login-password"
                       type="password"
                       class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-3 pr-11 text-sm text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition" />
                <button type="button"
                        onclick="togglePasswordVisibility('login-password', this)"
                        class="absolute inset-y-0 right-0 flex items-center px-3 text-slate-400 hover:text-cyan-400 transition"
                        aria-label="Toggle password visibility">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Input.Password" class="text-xs font-medium text-rose-400 mt-1 block"></span>
        </div>
        <div class="pt-2">
            <button type="submit"
                    class="w-full inline-flex items-center justify-center rounded-xl bg-cyan-600 px-6 py-3 text-sm font-bold tracking-wide text-white shadow-sm hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all duration-200">
                Sign In
            </button>
        </div>
    </form>

    <div class="mt-5 text-center">
        <a href="/Account/Activate" class="text-xs text-slate-500 hover:text-cyan-400 transition">First time here? Activate your account &rarr;</a>
    </div>

    @if (Model.ShowDemoCredentials && Model.DemoUsers.Count > 0)
    {
        <div class="mt-8 rounded-xl border border-slate-700/60 bg-slate-800/40 p-5">
            <p class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Configured dev credentials</p>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="text-slate-400">
                        <tr><th class="pb-1">Username</th><th class="pb-1">Password</th><th class="pb-1">Role</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model.DemoUsers)
                    {
                        <tr>
                            <td class="font-mono py-0.5">@user.Username</td>
                            <td class="font-mono py-0.5">@user.Password</td>
                            <td class="font-mono py-0.5">@user.Role</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, btn) {
            var input = document.getElementById(inputId);
            var isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            btn.innerHTML = isHidden
                ? `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.477 0-8.268-2.943-9.542-7a9.956 9.956 0 012.293-3.95M6.228 6.228A9.956 9.956 0 0112 5c4.477 0 8.268 2.943 9.542 7a9.956 9.956 0 01-1.772 3.274M6.228 6.228L3 3m3.228 3.228l3.65 3.65M17.772 15.272l3.228 3.228m-3.228-3.228l-3.65-3.65" />
                   </svg>`
                : `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                     <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                   </svg>`;
        }
    </script>
}
