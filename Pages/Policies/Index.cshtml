@page
@model DigifyCXIntranet.Pages.Policies.IndexModel
@{
    ViewData["Title"] = "Policies & Procedures";
}

<!-- Main Page Container -->
<div class="mx-auto max-w-5xl bg-[#1e2336] rounded-2xl p-6 lg:p-8 border border-slate-700 shadow-xl">
    
    <!-- Header -->
    <div class="mb-6 border-b border-slate-700/80 pb-5">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Policies & Procedures</h1>
        <p class="mt-2 text-sm text-slate-400">Documents are displayed in read-only format for controlled distribution and auditability.</p>
    </div>

    <!-- Search Form -->
    <form method="get" class="mb-8 flex flex-col sm:flex-row gap-3">
        <div class="flex-grow">
            <input asp-for="Search" class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-400 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition" placeholder="Search title or content..." />
        </div>
        <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-cyan-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition">
            Search
        </button>
    </form>

    @if (Model.Items.Count == 0)
    {
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center rounded-xl bg-slate-800/30 py-12 border border-slate-700/50 border-dashed">
            <p class="text-slate-400 font-medium">No policy documents found matching your search.</p>
        </div>
    }
    else
    {
        <!-- Table Container -->
        <div class="overflow-hidden rounded-xl border border-slate-700/60 bg-slate-800/40 shadow-inner">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-800/80 text-xs uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-700/60">
                        <tr>
                            <th scope="col" class="px-6 py-4">Title</th>
                            <th scope="col" class="px-6 py-4">Type</th>
                            <th scope="col" class="px-6 py-4">Version</th>
                            <th scope="col" class="px-6 py-4">Effective Date</th>
                            <th scope="col" class="px-6 py-4 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700/50">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-700/30 transition-colors duration-150">
                                <td class="px-6 py-4 font-medium text-white">@item.Title</td>
                                <td class="px-6 py-4 text-cyan-100/80">@item.ContentType</td>
                                <td class="px-6 py-4 font-mono text-xs text-slate-400">@item.VersionLabel</td>
                                <td class="px-6 py-4 whitespace-nowrap">@item.EffectiveDate.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <a asp-page="/Policies/View" asp-route-id="@item.Id" class="inline-flex items-center justify-center rounded-lg border border-cyan-500/50 bg-cyan-500/10 px-4 py-1.5 text-xs font-semibold text-cyan-400 hover:bg-cyan-500 hover:text-white transition-all duration-200">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>