@page
@model DigifyCXIntranet.Pages.Policies.IndexModel
@{
    ViewData["Title"] = "Policies";
}

<section class="dcx-policies-hero mb-4">
    <div class="dcx-policies-hero__content">
        <div>
            <div class="dcx-kicker mb-3">Zendesk Policy Library</div>
            <h1 class="dcx-policies-title">Policies that are <span>easy to find</span></h1>
            <p class="dcx-policies-copy mt-3 mb-0">
                Articles are synced from Zendesk and grouped by collection so agents can browse without seeing internal sync labels first.
            </p>
        </div>

        <div class="d-flex flex-column align-items-start align-items-lg-end gap-3">
            <a asp-page="/Policies/ComplianceReport" class="dcx-btn-secondary">Compliance Report</a>
            <img src="~/images/branding/digifycx-logo.png"
                 alt=""
                 aria-hidden="true"
                 class="dcx-policies-watermark" />
        </div>
    </div>
</section>

<section class="dcx-policies-panel">
    <form method="get" class="row g-3 align-items-end mb-4">
        <div class="col-lg-8">
            <label asp-for="Search" class="dcx-label mb-2">Search policies</label>
            <input asp-for="Search" class="dcx-input" placeholder="Search by title or keyword" />
        </div>
        <div class="col-lg-4">
            <button type="submit" class="dcx-btn w-100">Search</button>
        </div>
    </form>

    @if (Model.Groups.Count == 0)
    {
        <div class="dcx-empty-state text-center">
            <img src="~/images/branding/digifycx-logo.png"
                 alt=""
                 aria-hidden="true"
                 class="dcx-empty-state__logo" />
            <div class="dcx-list-card__title">No synced policy articles found yet.</div>
            <div class="dcx-list-card__meta">Run a Zendesk sync from the admin console once the connection is ready.</div>
        </div>
    }
    else
    {
        <div class="dcx-policy-group-stack">
            @foreach (var group in Model.Groups)
            {
                <details class="dcx-policy-group" open>
                    <summary class="dcx-policy-group__summary">
                        <div>
                            <div class="dcx-policy-group__title">@group.Section</div>
                            <div class="dcx-policy-group__meta">@group.Category · @group.Items.Count article(s)</div>
                        </div>
                    </summary>

                    <div class="dcx-policy-group__body">
                        <div class="row g-3">
                            @foreach (var item in group.Items)
                            {
                                <div class="col-lg-6">
                                    <a asp-page="/Policies/View" asp-route-id="@item.Id" class="dcx-policy-link h-100">
                                        <div class="dcx-policy-link__title">@item.Title</div>
                                        <div class="dcx-policy-link__meta">Updated @item.UpdatedAtUtc.ToString("dd MMM yyyy")</div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </details>
            }
        </div>
        <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
    }
</section>
