@page
@model DigifyCXIntranet.Pages.Policies.IndexModel
@{
    ViewData["Title"] = "Policies & Procedures";
}

<div class="card-elevated p-4">
    <h1 class="h4 mb-2">Policies & Procedures</h1>
    <p class="text-muted mb-3">Documents are displayed in read-only format for controlled distribution and auditability.</p>

    <form method="get" class="row g-2 mb-3">
        <div class="col-sm-8 col-md-6">
            <input asp-for="Search" class="form-control" placeholder="Search title or content" />
        </div>
        <div class="col-sm-4 col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <p class="text-muted mb-0">No policy documents found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Version</th>
                        <th>Effective Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.ContentType</td>
                        <td>@item.VersionLabel</td>
                        <td>@item.EffectiveDate.ToString("dd MMM yyyy")</td>
                        <td><a asp-page="/Policies/View" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
