@page "{id:int}"
@model DigifyCXIntranet.Pages.Policies.ViewModel
@{
    ViewData["Title"] = "Policy View";
}

@if (Model.Item is null)
{
    <div class="dcx-inline-alert dcx-inline-alert--warning">
        Policy article not found.
    </div>
}
else
{
    <article class="dcx-policy-view">
        <header class="dcx-policy-view__header">
            <div class="d-flex justify-content-between flex-wrap gap-3">
                <div>
                    <div class="dcx-kicker mb-3">Policy Article</div>
                    <h1 class="dcx-policy-view__title">@Model.Item.Title</h1>
                    <div class="dcx-policy-view__section">
                        @(string.IsNullOrWhiteSpace(Model.Item.SectionName) ? "Policy Library" : Model.Item.SectionName)
                    </div>
                </div>

                <div class="dcx-policy-view__updated">
                    Updated @Model.Item.UpdatedAtUtc.ToString("dd MMM yyyy")
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.AcknowledgeMessage))
        {
            <div class="dcx-inline-alert dcx-inline-alert--success mb-3">
                @Model.AcknowledgeMessage
            </div>
        }

        <section class="dcx-policy-reader mb-3 zendesk-policy-content">
            @Html.Raw(Model.Item.Body)
        </section>

        <div class="d-flex flex-wrap gap-3 mb-3">
            <a href="@Model.Item.HtmlUrl"
               target="_blank"
               rel="noreferrer noopener"
               class="dcx-btn-secondary">
                Open Source Article
            </a>
        </div>

        @if (Model.AlreadyAcknowledged)
        {
            <div class="dcx-inline-alert dcx-inline-alert--info mb-0">
                You have already acknowledged this policy version.
            </div>
        }
        else
        {
            <form method="post" asp-page-handler="Acknowledge" class="dcx-policy-ack">
                <input type="hidden" name="id" value="@Model.Item.Id" />

                <label class="dcx-policy-ack__check">
                    <input type="checkbox" id="ack" required />
                    <span>I acknowledge that I have read this policy.</span>
                </label>

                <button type="submit" class="dcx-btn">Acknowledge Policy</button>
            </form>
        }
    </article>
}