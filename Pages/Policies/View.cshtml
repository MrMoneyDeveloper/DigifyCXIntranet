@page "{id:int}"
@model DigifyCXIntranet.Pages.Policies.ViewModel
@{
    ViewData["Title"] = "Policy View";
}

@if (Model.Item is null)
{
    <div class="alert alert-warning">Document not found.</div>
}
else
{
    <article class="card-elevated p-4">
        <div class="d-flex justify-content-between flex-wrap mb-3">
            <div>
                <h1 class="h4 mb-1">@Model.Item.Title</h1>
                <div class="text-muted">@Model.Item.ContentType | Version @Model.Item.VersionLabel</div>
            </div>
            <div class="small text-muted">Effective @Model.Item.EffectiveDate.ToString("dd MMM yyyy")</div>
        </div>
        <div class="border rounded p-3 bg-light-subtle">
            @Model.Item.Content
        </div>
        <p class="small text-muted mt-3 mb-0">Read-only view. Download and export are intentionally not provided for controlled access.</p>
    </article>
}
