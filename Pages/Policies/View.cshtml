@page "{id:int}"
@model DigifyCXIntranet.Pages.Policies.ViewModel
@{
    ViewData["Title"] = "Policy View";
}

@if (Model.Item is null)
{
    <div class="alert alert-warning">Policy article not found.</div>
}
else
{
    <article class="card-elevated p-4">
        <div class="d-flex justify-content-between flex-wrap mb-3">
            <div>
                <h1 class="h4 mb-1">@Model.Item.Title</h1>
                <div class="text-muted">Version @Model.Item.VersionLabel</div>
            </div>
            <div class="small text-muted">@Model.Item.UpdatedAtUtc.ToString("dd MMM yyyy HH:mm")</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.AcknowledgeMessage))
        {
            <div class="alert alert-success">@Model.AcknowledgeMessage</div>
        }

        <div class="border rounded p-3 bg-light-subtle mb-3">
            @Model.Item.Body
        </div>
        <a href="@Model.Item.HtmlUrl" target="_blank" rel="noreferrer noopener" class="btn btn-sm btn-outline-primary mb-3">Open in Zendesk</a>

        @if (Model.AlreadyAcknowledged)
        {
            <div class="alert alert-info mb-0">You have already acknowledged this policy version.</div>
        }
        else
        {
            <form method="post" asp-page-handler="Acknowledge">
                <input type="hidden" name="id" value="@Model.Item.Id" />
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="ack" required />
                    <label class="form-check-label" for="ack">
                        I explicitly acknowledge that I have read and agree to this policy version (@Model.Item.VersionLabel).
                    </label>
                </div>
                <button type="submit" class="btn btn-primary">Acknowledge Policy</button>
            </form>
        }
    </article>
}
