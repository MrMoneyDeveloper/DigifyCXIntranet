@page
@model DigifyCXIntranet.Pages.Chatbot.IndexModel
@{
    ViewData["Title"] = "Chatbot";
}

<!-- Mock Chat Application Container -->
<div class="mx-auto max-w-3xl bg-[#1e2336] rounded-2xl overflow-hidden border border-slate-700 shadow-2xl flex flex-col h-[600px]">
    
    <!-- Chat Header -->
    <div class="bg-slate-800/90 border-b border-slate-700 px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <!-- Bot Avatar Placeholder -->
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/20 border-2 border-slate-700">
                <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
            </div>
            <div>
                <h1 class="text-xl font-bold text-white tracking-tight">Employee Help Chatbot</h1>
                <div class="flex items-center gap-2 mt-0.5">
                    <!-- Pulsing status dot -->
                    <div class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></div>
                    <span class="text-xs font-semibold text-amber-400/80 uppercase tracking-wider">Integration Pending</span>
                </div>
            </div>
        </div>
        
        <!-- Header Options (Visual only) -->
        <div class="flex items-center gap-3 text-slate-500">
            <svg class="w-6 h-6 hover:text-slate-300 transition cursor-pointer" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
        </div>
    </div>

    <!-- Chat Message Area -->
    <div class="flex-grow bg-slate-900/50 p-6 sm:p-8 flex flex-col justify-center relative overflow-hidden">
        
        <!-- Decorative Background Icon -->
        <div class="absolute inset-0 flex items-center justify-center opacity-[0.03] pointer-events-none">
            <svg class="w-64 h-64 text-cyan-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z" /></svg>
        </div>

        <!-- "System" Message Bubble -->
        <div class="bg-slate-800/80 border border-slate-700 rounded-2xl rounded-tl-none p-6 shadow-md z-10 w-full max-w-lg relative animate-reveal">
            
            <p class="text-slate-300 font-medium mb-6 leading-relaxed">
                This module is securely reserved and ready for integration with your preferred automated workflow. Once connected, it will provide real-time, dynamic support.
            </p>
            
            <div class="space-y-4">
                <!-- Step 1 -->
                <div class="flex items-start gap-3 bg-slate-900/60 rounded-xl p-3 border border-slate-700/50 hover:border-cyan-500/30 transition-colors">
                    <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-xs font-bold mt-0.5">1</div>
                    <p class="text-sm text-slate-400"><span class="text-cyan-300 font-semibold">Route Intents:</span> Direct FAQs and policy lookups to this interface.</p>
                </div>
                
                <!-- Step 2 -->
                <div class="flex items-start gap-3 bg-slate-900/60 rounded-xl p-3 border border-slate-700/50 hover:border-cyan-500/30 transition-colors">
                    <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-xs font-bold mt-0.5">2</div>
                    <p class="text-sm text-slate-400"><span class="text-cyan-300 font-semibold">Connect Knowledge:</span> Link to approved internal data sources for accurate responses.</p>
                </div>
                
                <!-- Step 3 -->
                <div class="flex items-start gap-3 bg-slate-900/60 rounded-xl p-3 border border-slate-700/50 hover:border-cyan-500/30 transition-colors">
                    <div class="flex-shrink-0 w-6 h-6 rounded-full bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-xs font-bold mt-0.5">3</div>
                    <p class="text-sm text-slate-400"><span class="text-cyan-300 font-semibold">Configure Triggers:</span> Apply role-based logic for sensitive HR and payroll queries.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Disabled Mock Input Area -->
    <div class="bg-slate-800/80 border-t border-slate-700 p-4 sm:px-6">
        <div class="relative">
            <!-- cursor-not-allowed visually shows it's disabled -->
            <input type="text" disabled class="w-full bg-slate-900/80 border border-slate-700 rounded-full py-3.5 pl-6 pr-14 text-sm text-slate-500 cursor-not-allowed placeholder-slate-600 focus:outline-none" placeholder="Chatbot integration required to start messaging..." />
            
            <button disabled class="absolute right-2 top-1.5 bottom-1.5 w-10 h-10 rounded-full bg-slate-700 flex items-center justify-center text-slate-500 cursor-not-allowed">
                <svg class="w-4 h-4 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>
    </div>

</div>