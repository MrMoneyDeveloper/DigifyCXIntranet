@page "{id:int}"
@model DigifyCXIntranet.Pages.Jobs.ApplyModel
@{
    ViewData["Title"] = "Apply";
}

@if (Model.Job is null)
{
    <div class="alert alert-warning">Job not found.</div>
}
else
{
    <section class="card-elevated p-4">
        <h1 class="h4 mb-1">Apply Internally: @Model.Job.Title</h1>
        <p class="text-muted mb-4">@Model.Job.Department</p>

        <form method="post" enctype="multipart/form-data" class="row g-3">
            <input asp-for="Input.JobPostingId" type="hidden" />
            <div class="col-md-6">
                <label asp-for="Input.EmployeeName" class="form-label"></label>
                <input asp-for="Input.EmployeeName" class="form-control" />
                <span asp-validation-for="Input.EmployeeName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.EmployeeEmail" class="form-label"></label>
                <input asp-for="Input.EmployeeEmail" class="form-control" />
                <span asp-validation-for="Input.EmployeeEmail" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Notes" class="form-label"></label>
                <textarea asp-for="Input.Notes" rows="4" class="form-control"></textarea>
            </div>
            <div class="col-12">
                <label asp-for="ResumeFile" class="form-label">Resume (PDF/DOCX, max 5MB)</label>
                <input asp-for="ResumeFile" type="file" accept=".pdf,.docx" class="form-control" />
                <span asp-validation-for="ResumeFile" class="text-danger"></span>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Submit Application</button>
                <a asp-page="/Jobs/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
