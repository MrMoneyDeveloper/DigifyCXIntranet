@page "{id:int}"
@model DigifyCXIntranet.Pages.Jobs.ApplyModel
@{
    ViewData["Title"] = "Apply";
}

@if (!string.IsNullOrWhiteSpace(Model.JobApplyMessage))
{
    <div class="dcx-inline-alert dcx-inline-alert--success mb-4">
        <div class="d-flex align-items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="flex-shrink-0 mt-1">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
                <strong>@Model.JobApplyMessage</strong>
                @if (!string.IsNullOrWhiteSpace(Model.JobApplyTicketId))
                {
                    <div class="mt-2">
                        Zendesk Ticket <strong>#@Model.JobApplyTicketId</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.JobApplyTicketUrl))
                        {
                            <span>
                                &mdash;
                                <a href="@Model.JobApplyTicketUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="dcx-text-link">
                                    View in Zendesk
                                </a>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (Model.Job is null)
{
    <div class="dcx-inline-alert dcx-inline-alert--warning">
        Job not found or no longer active.
    </div>
}
else
{
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="dcx-validation-summary mb-4">
            <strong>Submission failed — please review the details below.</strong>
            <div asp-validation-summary="All" class="mt-2 mb-0"></div>
        </div>
    }

    <section class="dcx-job-apply-shell">
        <header class="dcx-job-apply-header">
            <div class="dcx-kicker mb-3">Internal Opportunity</div>
            <h1 class="dcx-job-apply-title">Apply internally: @Model.Job.Title</h1>
            <p class="dcx-job-apply-copy mt-2 mb-0">
                @Model.Job.Department
            </p>
        </header>

        <section class="dcx-job-apply-panel">
            <form method="post" enctype="multipart/form-data" class="row g-3">
                <input asp-for="Input.JobPostingId" type="hidden" />

                <div class="col-md-6">
                    <label for="employee-name" class="dcx-label mb-2">Employee name</label>
                    <input id="employee-name" value="@Model.EmployeeName" class="dcx-input" readonly aria-readonly="true" />
                </div>

                <div class="col-md-6">
                    <label for="employee-email" class="dcx-label mb-2">Employee email</label>
                    <input id="employee-email" type="email" value="@Model.EmployeeEmail" class="dcx-input" readonly aria-readonly="true" />
                </div>

                <div class="col-12">
                    <label asp-for="Input.Notes" class="dcx-label mb-2"></label>
                    <textarea asp-for="Input.Notes" rows="5" class="dcx-textarea"></textarea>
                </div>

                <div class="col-12">
                    <label asp-for="ResumeFile" class="dcx-label mb-2">
                        Resume <span class="dcx-helper-inline">(PDF or DOCX — max 5 MB)</span>
                    </label>
                    <input asp-for="ResumeFile" type="file" accept=".pdf,.docx" class="dcx-file-input" />
                    <span asp-validation-for="ResumeFile" class="dcx-field-error mt-1"></span>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="dcx-btn">Submit Application</button>
                    <a asp-page="/Jobs/Index" class="dcx-btn-ghost">Cancel</a>
                </div>
            </form>
        </section>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
