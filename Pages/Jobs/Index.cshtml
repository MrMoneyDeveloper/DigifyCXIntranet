@page
@model DigifyCXIntranet.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Job Postings";
}

<div class="mx-auto max-w-6xl space-y-6 mt-4">
    <div class="bg-[#1e2336] rounded-2xl p-6 lg:p-8 border border-slate-700 shadow-xl">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Internal Job Postings</h1>
        <p class="mt-2 text-sm text-slate-400">Apply directly or send secure referral invites for external candidates.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
    {
        <div class="alert alert-success">@Model.FeedbackMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.JobApplyMessage))
    {
        <div class="alert alert-success">@Model.JobApplyMessage</div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="bg-[#1e2336] rounded-2xl p-10 border border-slate-700 shadow-lg text-center">
            <h3 class="text-lg font-medium text-white">No active job postings</h3>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            @foreach (var item in Model.Items)
            {
                <article class="bg-[#1e2336] rounded-2xl p-5 border border-slate-700 shadow-xl flex flex-col gap-4">
                    @if (item.UseVisualAd)
                    {
                        var backgroundUrl = string.IsNullOrWhiteSpace(item.AdBackgroundImagePath)
                            ? "/images/job-ad-a4-template.svg"
                            : item.AdBackgroundImagePath;
                        <div class="job-ad-a4" style="background-image:linear-gradient(180deg,rgba(15,23,42,0.1),rgba(15,23,42,0.95)),url('@backgroundUrl');">
                            <div class="job-ad-layer">
                                <div class="job-ad-pill">@item.Department</div>
                                <h2 class="job-ad-title">@(string.IsNullOrWhiteSpace(item.AdHeadline) ? item.Title : item.AdHeadline)</h2>
                                <p class="job-ad-subtitle">@(string.IsNullOrWhiteSpace(item.AdSubHeadline) ? item.Description : item.AdSubHeadline)</p>
                                <div class="job-ad-footer">Closes @item.ClosingDate.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                    }
                    <p class="text-sm text-slate-300">@item.Description</p>
                    <div class="text-sm text-cyan-300"><span class="fw-semibold">Apply via:</span> @item.ApplicationRoute</div>

                    <div class="d-flex flex-column gap-2">
                        <a asp-page="/Jobs/Apply" asp-route-id="@item.Id" class="btn btn-primary">Apply Internally</a>
                        @if (item.IsExternalReferral)
                        {
                            <form method="post" asp-page-handler="Refer" class="d-flex gap-2">
                                <input type="hidden" asp-for="Referral.JobPostingId" value="@item.Id" />
                                <input name="Referral.CandidateEmail" class="form-control form-control-sm" placeholder="friend@email.com" />
                                <button type="submit" class="btn btn-outline-primary btn-sm">Send Referral</button>
                            </form>
                        }
                        else
                        {
                            <div class="text-xs text-slate-400">External referral is disabled for this role.</div>
                        }
                    </div>

                    @if (item.IsExternalReferral)
                    {
                        <span class="badge text-bg-warning">External referral enabled</span>
                    }
                </article>
            }
        </div>
    }
</div>
