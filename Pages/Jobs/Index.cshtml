@page
@model DigifyCXIntranet.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Job Postings";
}

<section class="hero-panel mb-4">
    <div class="page-kicker mb-3">Internal Openings</div>
    <h1 class="page-title">Roles that power <span>high performance</span></h1>
    <p class="page-copy mt-3 mb-0">Apply for yourself or refer someone strong. Referral details are sent to HR through Zendesk.</p>
</section>

@if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
{
    <div class="alert alert-success">@Model.FeedbackMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.JobApplyMessage))
{
    <div class="alert alert-success">@Model.JobApplyMessage</div>
}

@if (Model.Items.Count == 0)
{
    <section class="soft-card text-center py-5">
        <h2 class="h5 mb-0">No active job postings</h2>
    </section>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col-xl-6">
                <article class="soft-card h-100">
                    @if (item.UseVisualAd)
                    {
                        var backgroundUrl = string.IsNullOrWhiteSpace(item.AdBackgroundImagePath)
                            ? "/images/job-ad-a4-template.svg"
                            : item.AdBackgroundImagePath;
                        <div class="job-ad-a4 mb-3" style="background-image:linear-gradient(180deg,rgba(15,27,45,0.12),rgba(15,27,45,0.82)),url('@backgroundUrl');">
                            <div class="job-ad-layer">
                                <div class="job-ad-pill">@item.Department</div>
                                <h2 class="job-ad-title">@(string.IsNullOrWhiteSpace(item.AdHeadline) ? item.Title : item.AdHeadline)</h2>
                                <p class="job-ad-subtitle">@(string.IsNullOrWhiteSpace(item.AdSubHeadline) ? item.Description : item.AdSubHeadline)</p>
                                <div class="job-ad-footer">Closes @item.ClosingDate.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                    }

                    <div class="d-flex flex-column gap-3">
                        <div>
                            <h2 class="h4 mb-2">@item.Title</h2>
                            <p class="page-copy mb-0">@item.Description</p>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <span class="meta-pill">@item.Department</span>
                            @if (item.IsExternalReferral)
                            {
                                <span class="meta-pill">Referral enabled</span>
                            }
                        </div>

                        <a asp-page="/Jobs/Apply" asp-route-id="@item.Id" class="btn btn-primary">Apply Internally</a>

                        @if (item.IsExternalReferral)
                        {
                            <details class="details-card">
                                <summary>
                                    <span class="fw-bold">Refer someone</span>
                                    <span class="d-block list-card-meta">Candidate details and optional CV</span>
                                </summary>
                                <div class="details-body">
                                    <form method="post" asp-page-handler="Refer" enctype="multipart/form-data" class="row g-3">
                                        <input type="hidden" asp-for="Referral.JobPostingId" value="@item.Id" />
                                        <div class="col-md-6">
                                            <input name="Referral.CandidateName" class="form-control" placeholder="Candidate name" />
                                        </div>
                                        <div class="col-md-6">
                                            <input name="Referral.CandidateEmail" class="form-control" placeholder="candidate@email.com" />
                                        </div>
                                        <div class="col-md-6">
                                            <input name="Referral.CandidatePhone" class="form-control" placeholder="Phone" />
                                        </div>
                                        <div class="col-md-6">
                                            <input name="ReferralResumeFile" type="file" accept=".pdf,.docx" class="form-control" />
                                        </div>
                                        <div class="col-12">
                                            <textarea name="Referral.Notes" rows="3" class="form-control" placeholder="Referral notes"></textarea>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-outline-primary">Submit Referral</button>
                                        </div>
                                    </form>
                                </div>
                            </details>
                        }
                    </div>
                </article>
            </div>
        }
    </div>
}
