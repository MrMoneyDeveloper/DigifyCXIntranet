@page
@model DigifyCXIntranet.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Job Postings";
}

<section class="dcx-jobs-hero mb-4">
    <div class="dcx-jobs-hero__content">
        <div>
            <div class="dcx-kicker mb-3">Internal Openings</div>
            <h1 class="dcx-jobs-title">Roles that power <span>high performance</span></h1>
            <p class="dcx-jobs-copy mt-3 mb-0">
                Apply for yourself or refer someone strong. All submissions go directly to HR via Zendesk.
            </p>
        </div>

        <div class="dcx-jobs-watermark-wrap">
            <img src="~/images/branding/digifycx-logo.png"
                 alt=""
                 aria-hidden="true"
                 class="dcx-jobs-watermark" />
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.JobApplyMessage))
{
    <div class="alert alert-success d-flex align-items-start gap-3 mb-4" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="flex-shrink-0 mt-1">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
            <strong>@Model.JobApplyMessage</strong>
            @if (!string.IsNullOrWhiteSpace(Model.JobApplyTicketId))
            {
                <div class="mt-1 fs-sm">
                    Zendesk Ticket&#160;<strong>#@Model.JobApplyTicketId</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.JobApplyTicketUrl))
                    {
                        <span>
                            &mdash;
                            <a href="@Model.JobApplyTicketUrl" target="_blank" rel="noopener noreferrer"
                               class="alert-link fw-semibold">View in Zendesk &rarr;</a>
                        </span>
                    }
                </div>
            }
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ReferralMessage))
{
    <div class="alert alert-success d-flex align-items-start gap-3 mb-4" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="flex-shrink-0 mt-1">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
            <strong>@Model.ReferralMessage</strong>
            @if (!string.IsNullOrWhiteSpace(Model.ReferralTicketId))
            {
                <div class="mt-1 fs-sm">
                    Zendesk Ticket&#160;<strong>#@Model.ReferralTicketId</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.ReferralTicketUrl))
                    {
                        <span>
                            &mdash;
                            <a href="@Model.ReferralTicketUrl" target="_blank" rel="noopener noreferrer"
                               class="alert-link fw-semibold">View in Zendesk &rarr;</a>
                        </span>
                    }
                </div>
            }
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ReferralError))
{
    <div class="alert alert-danger d-flex align-items-start gap-3 mb-4" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="flex-shrink-0 mt-1">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
        </svg>
        <div>
            <strong>Referral could not be submitted to Zendesk.</strong>
            <div class="mt-1">@Model.ReferralError</div>
            <div class="mt-2 text-muted" style="font-size:.85em">
                If this keeps happening, contact your system administrator and quote the error above.
            </div>
        </div>
    </div>
}

@if (Model.Items.Count == 0)
{
    <section class="dcx-empty-state text-center">
        <img src="~/images/branding/digifycx-logo.png"
             alt=""
             aria-hidden="true"
             class="dcx-empty-state__logo" />
        <h2 class="h5 mb-2">No active job postings right now</h2>
        <p class="mb-0 text-white-50">New internal openings and referral-enabled roles will appear here.</p>
    </section>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col-xl-6">
                <article class="dcx-job-card h-100">
                    @if (item.UseVisualAd)
                    {
                        var backgroundUrl = string.IsNullOrWhiteSpace(item.AdBackgroundImagePath)
                            ? "/images/job-ad-a4-template.svg"
                            : item.AdBackgroundImagePath;
                        <div class="job-ad-a4 mb-3" style="background-image:linear-gradient(180deg,rgba(15,27,45,0.18),rgba(15,27,45,0.88)),url('@backgroundUrl');">
                            <div class="job-ad-layer">
                                <div class="job-ad-pill">@item.Department</div>
                                <h2 class="job-ad-title">@(string.IsNullOrWhiteSpace(item.AdHeadline) ? item.Title : item.AdHeadline)</h2>
                                <p class="job-ad-subtitle">@(string.IsNullOrWhiteSpace(item.AdSubHeadline) ? item.Description : item.AdSubHeadline)</p>
                                <div class="job-ad-footer">Closes @item.ClosingDate.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                    }

                    <div class="d-flex flex-column gap-3">
                        <div>
                            <h2 class="dcx-job-card__title mb-2">@item.Title</h2>
                            <p class="dcx-job-card__copy mb-0">@item.Description</p>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <span class="dcx-chip">@item.Department</span>
                            @if (item.IsExternalReferral)
                            {
                                <span class="dcx-chip">Referral enabled</span>
                            }
                        </div>

                        <a asp-page="/Jobs/Apply" asp-route-id="@item.Id" class="dcx-btn">Apply Internally</a>

                        @if (item.IsExternalReferral)
                        {
                            <details class="details-card dcx-details-card">
                                <summary>
                                    <span class="fw-bold">Refer someone</span>
                                    <span class="d-block list-card-meta">Candidate details and optional CV</span>
                                </summary>
                                <div class="details-body">
                                    @if (!ViewData.ModelState.IsValid && Model.Referral.JobPostingId == item.Id)
                                    {
                                        <div class="alert alert-danger py-2 mb-3" role="alert">
                                            <div asp-validation-summary="All" class="mb-0"></div>
                                        </div>
                                    }
                                    <form method="post" asp-page-handler="Refer" enctype="multipart/form-data" class="row g-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Referral.JobPostingId" value="@item.Id" />
                                        <div class="col-md-6">
                                            <label class="form-label">Candidate Name <span class="text-danger">*</span></label>
                                            <input name="Referral.CandidateName" class="form-control" placeholder="Full name" required
                                                   value="@(Model.Referral.JobPostingId == item.Id ? Model.Referral.CandidateName : "")" />
                                            <span class="text-danger small">
                                                @Html.ValidationMessage("Referral.CandidateName")
                                            </span>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Candidate Email <span class="text-danger">*</span></label>
                                            <input name="Referral.CandidateEmail" type="email" class="form-control" placeholder="candidate@email.com" required
                                                   value="@(Model.Referral.JobPostingId == item.Id ? Model.Referral.CandidateEmail : "")" />
                                            <span class="text-danger small">
                                                @Html.ValidationMessage("Referral.CandidateEmail")
                                            </span>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Phone Number<span class="text-muted"></span></label>
                                            <input name="Referral.CandidatePhone" class="form-control" placeholder="+27 xx xxx xxxx"
                                                   value="@(Model.Referral.JobPostingId == item.Id ? Model.Referral.CandidatePhone : "")" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">CV / Resume <span class="text-muted">(PDF or DOCX, max 5 MB)</span></label>
                                            <input name="ReferralResumeFile" type="file" accept=".pdf,.docx" class="form-control" />
                                            <span class="text-danger small">
                                                @Html.ValidationMessage("ReferralResumeFile")
                                            </span>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Notes <span class="text-muted">(optional)</span></label>
                                            <textarea name="Referral.Notes" rows="3" class="form-control" placeholder="Why are you referring this candidate?">@(Model.Referral.JobPostingId == item.Id ? Model.Referral.Notes : "")</textarea>
                                        </div>
                                        <div class="col-12 d-flex flex-wrap align-items-center gap-3">
                                            <button type="submit" class="dcx-btn">Submit Referral</button>
                                            <span class="text-muted small">Submits directly to HR via Zendesk</span>
                                        </div>
                                    </form>
                                </div>
                            </details>
                        }
                    </div>
                </article>
            </div>
        }
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}