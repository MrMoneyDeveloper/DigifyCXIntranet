@page
@model DigifyCXIntranet.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<section class="dcx-profile-shell">
    <header class="dcx-profile-header">
        <div class="dcx-profile-header__identity">
            <div class="dcx-profile-avatar" aria-hidden="true">
                <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>

            <div>
                <div class="dcx-kicker mb-3">Employee Profile</div>
                <h1 class="dcx-profile-title">Your DigifyCX account</h1>
                <p class="dcx-profile-copy mt-2 mb-0">
                    View your core account details and basic identity information used throughout the intranet.
                </p>
            </div>
        </div>
    </header>

    <section class="dcx-profile-panel">
        <div class="dcx-profile-grid">
            <div class="dcx-profile-field">
                <label class="dcx-label mb-2">Display Name</label>
                <div class="dcx-profile-readonly">
                    <span class="dcx-profile-readonly__icon" aria-hidden="true">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" />
                        </svg>
                    </span>
                    <input value="@Model.DisplayName" readonly class="dcx-profile-readonly__input" />
                </div>
            </div>

            <div class="dcx-profile-field">
                <label class="dcx-label mb-2">Company Login</label>
                <div class="dcx-profile-readonly">
                    <span class="dcx-profile-readonly__icon" aria-hidden="true">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </span>
                    <input value="@Model.IdentityName" readonly class="dcx-profile-readonly__input" />
                </div>
            </div>
        </div>
    </section>

    <section class="dcx-profile-note">
        <span class="dcx-profile-note__icon" aria-hidden="true">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </span>
        <p class="mb-0">
            This screen is a starter profile view. Extend it with employee attributes from HR systems if required.
        </p>
    </section>
</section>