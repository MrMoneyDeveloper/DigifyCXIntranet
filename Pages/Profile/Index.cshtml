@page
@model DigifyCXIntranet.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
    var currentMonthSpendText = $"{Model.CurrentMonthCanteenSpend:C} this month";
    var pendingPolicyText = $"{Model.PendingPolicyCount} pending";
}

<section class="dcx-profile-shell">
    <header class="dcx-profile-header">
        <div class="dcx-profile-header__identity">
            <div class="dcx-profile-avatar" aria-hidden="true">
                <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>

            <div>
                <div class="dcx-kicker mb-3">Employee Profile</div>
                <h1 class="dcx-profile-title">@Model.DisplayName</h1>
                <p class="dcx-profile-copy mt-2 mb-0">
                    Your read-only account summary and recent intranet activity.
                </p>
            </div>
        </div>
    </header>

    <section class="dcx-profile-panel">
        <div class="dcx-profile-grid">
            <div class="dcx-profile-field">
                <label for="profile-display-name" class="dcx-label mb-2">Display name</label>
                <div class="dcx-profile-readonly">
                    <span class="dcx-profile-readonly__icon" aria-hidden="true">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" />
                        </svg>
                    </span>
                    <input id="profile-display-name" value="@Model.DisplayName" readonly class="dcx-profile-readonly__input" />
                </div>
            </div>

            <div class="dcx-profile-field">
                <label for="profile-login" class="dcx-label mb-2">Company login</label>
                <div class="dcx-profile-readonly">
                    <span class="dcx-profile-readonly__icon" aria-hidden="true">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </span>
                    <input id="profile-login" value="@Model.CompanyLogin" readonly class="dcx-profile-readonly__input" />
                </div>
            </div>

            <div class="dcx-profile-field">
                <label for="profile-role" class="dcx-label mb-2">Role</label>
                <div class="dcx-profile-readonly">
                    <span class="dcx-profile-readonly__icon" aria-hidden="true">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </span>
                    <input id="profile-role" value="@Model.RoleName" readonly class="dcx-profile-readonly__input" />
                </div>
            </div>

            <div class="dcx-profile-field">
                <label for="profile-activation" class="dcx-label mb-2">Account activation</label>
                <div class="dcx-profile-readonly">
                    <span class="dcx-profile-readonly__icon" aria-hidden="true">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 13l4 4L19 7" />
                        </svg>
                    </span>
                    <input id="profile-activation" value="@(Model.IsFirstTimeLogin ? "Activation pending" : "Activated")" readonly class="dcx-profile-readonly__input" />
                </div>
            </div>
        </div>
    </section>

    <section class="dcx-profile-panel">
        <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
            <div>
                <div class="dcx-kicker mb-2">Canteen</div>
                <h2 class="dcx-section-heading mb-0">Your canteen activity</h2>
            </div>
            <div class="dcx-profile-readonly" style="max-width: 18rem;">
                <span class="dcx-profile-readonly__icon" aria-hidden="true">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
                    </svg>
                </span>
                <input value="@currentMonthSpendText" aria-label="Canteen spend this month" readonly class="dcx-profile-readonly__input" />
            </div>
        </div>

        @if (Model.RecentCanteenOrders.Count == 0)
        {
            <div class="dcx-empty-state text-center py-4">
                <p class="mb-0">No canteen orders found for your account.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Item</th>
                            <th scope="col">Meal</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Amount</th>
                            <th scope="col" class="text-end">Ordered</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var order in Model.RecentCanteenOrders)
                    {
                        <tr>
                            <td>@order.ItemSummary</td>
                            <td>@order.MealSlot</td>
                            <td>@order.Status</td>
                            <td class="text-end">@order.TotalAmount.ToString("C")</td>
                            <td class="text-end">@order.OrderTimeUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="dcx-profile-panel">
        <div class="dcx-kicker mb-2">Jobs</div>
        <h2 class="dcx-section-heading mb-4">Your recent applications</h2>

        @if (Model.RecentJobApplications.Count == 0)
        {
            <div class="dcx-empty-state text-center py-4">
                <p class="mb-0">No job applications found for your account.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Role</th>
                            <th scope="col">Department</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Submitted</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var application in Model.RecentJobApplications)
                    {
                        <tr>
                            <td>@application.JobTitle</td>
                            <td>@(string.IsNullOrWhiteSpace(application.Department) ? "Not listed" : application.Department)</td>
                            <td>@application.Status</td>
                            <td class="text-end">@application.SubmittedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="dcx-profile-panel">
        <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
            <div>
                <div class="dcx-kicker mb-2">Policies</div>
                <h2 class="dcx-section-heading mb-0">Your policy acknowledgements</h2>
            </div>
            <div class="dcx-profile-readonly" style="max-width: 18rem;">
                <span class="dcx-profile-readonly__icon" aria-hidden="true">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z" />
                    </svg>
                </span>
                <input value="@pendingPolicyText" aria-label="Policies awaiting acknowledgement" readonly class="dcx-profile-readonly__input" />
            </div>
        </div>

        @if (Model.RecentPolicyAcknowledgements.Count == 0)
        {
            <div class="dcx-empty-state text-center py-4">
                <p class="mb-0">No policy acknowledgements found for your account.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Policy</th>
                            <th scope="col">Version</th>
                            <th scope="col" class="text-end">Acknowledged</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var acknowledgement in Model.RecentPolicyAcknowledgements)
                    {
                        <tr>
                            <td>@acknowledgement.PolicyTitle</td>
                            <td>@acknowledgement.Version</td>
                            <td class="text-end">@acknowledgement.AcknowledgedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
