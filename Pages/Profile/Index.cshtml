@page
@model DigifyCXIntranet.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<div class="mx-auto max-w-3xl bg-[#1e2336] rounded-2xl p-6 lg:p-8 border border-slate-700 shadow-xl mt-4">
    
    <!-- Profile Header with Avatar -->
    <div class="flex items-center gap-5 mb-8 border-b border-slate-700/80 pb-6">
        <!-- Avatar Placeholder -->
        <div class="h-20 w-20 flex-shrink-0 rounded-full bg-gradient-to-tr from-cyan-600 to-blue-700 flex items-center justify-center shadow-lg border-4 border-slate-800">
            <svg class="h-10 w-10 text-white opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
        </div>
        <div>
            <h1 class="text-3xl font-extrabold text-white tracking-tight">Employee Profile</h1>
            <p class="mt-1 text-sm text-slate-400">Manage your personal information and platform settings.</p>
        </div>
    </div>

    <!-- Read-Only Form Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Display Name -->
        <div>
            <label class="block text-sm font-semibold text-slate-300 mb-1.5">Display Name</label>
            <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
                    <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
                </div>
                <!-- cursor-not-allowed and a darker background visually indicate it cannot be edited -->
                <input class="w-full rounded-xl border border-slate-700 bg-slate-800/40 py-3 pl-10 pr-4 text-sm font-medium text-slate-300 cursor-not-allowed focus:outline-none shadow-inner" value="@Model.DisplayName" readonly />
            </div>
        </div>

        <!-- Company Login -->
        <div>
            <label class="block text-sm font-semibold text-slate-300 mb-1.5">Company Login</label>
            <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
                    <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                <input class="w-full rounded-xl border border-slate-700 bg-slate-800/40 py-3 pl-10 pr-4 text-sm font-medium text-slate-300 cursor-not-allowed focus:outline-none shadow-inner" value="@Model.IdentityName" readonly />
            </div>
        </div>
        
    </div>

    <!-- Developer/HR Note -->
    <div class="mt-8 flex items-start gap-3 rounded-xl bg-cyan-900/10 p-4 border border-cyan-500/20">
        <svg class="h-5 w-5 text-cyan-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <p class="text-sm text-cyan-100/70 leading-relaxed font-medium">
            This screen is a starter profile view. Extend it with employee attributes from HR systems if required.
        </p>
    </div>
    
</div>