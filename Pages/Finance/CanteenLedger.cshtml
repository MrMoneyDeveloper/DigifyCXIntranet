@page
@model DigifyCXIntranet.Pages.Finance.CanteenLedgerModel
@{
    ViewData["Title"] = "Canteen Ledger";
    var fromDate = Model.FromUtc?.ToString("yyyy-MM-dd");
    var toDate = Model.ToUtc?.ToString("yyyy-MM-dd");
}

<section class="dcx-ledger-shell">
    <header class="dcx-ledger-header">
        <div>
            <div class="dcx-kicker mb-3">Finance</div>
            <h1 class="dcx-ledger-title">Canteen <span>ledger</span></h1>
            <p class="dcx-ledger-copy mt-3 mb-0">
                Search employee canteen purchases, review totals, and export account records.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/Finance/Audit" class="dcx-btn-secondary">Audit Trail</a>
            <a asp-page-handler="Export"
               asp-route-Employee="@Model.Employee"
               asp-route-FromUtc="@fromDate"
               asp-route-ToUtc="@toDate"
               class="dcx-btn-secondary">
                Export XLSX
            </a>
        </div>
    </header>

    <section class="dcx-ledger-filters">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="dcx-validation-summary mb-3">@Model.ErrorMessage</div>
        }
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="Employee" class="dcx-label mb-2"></label>
                <input asp-for="Employee" class="dcx-input" placeholder="employee username or blank for all" />
            </div>

            <div class="col-md-3">
                <label asp-for="FromUtc" class="dcx-label mb-2">From</label>
                <input asp-for="FromUtc" type="date" class="dcx-input" />
            </div>

            <div class="col-md-3">
                <label asp-for="ToUtc" class="dcx-label mb-2">To</label>
                <input asp-for="ToUtc" type="date" class="dcx-input" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="dcx-btn w-100">Search</button>
            </div>
        </form>
    </section>

    <section class="dcx-ledger-kpis">
        <article class="dcx-ledger-kpi">
            <div class="dcx-ledger-kpi__label">Employees</div>
            <div class="dcx-ledger-kpi__value">@Model.SummaryRows.Count</div>
        </article>

        <article class="dcx-ledger-kpi">
            <div class="dcx-ledger-kpi__label">Orders</div>
            <div class="dcx-ledger-kpi__value">@Model.OrderCount</div>
        </article>

        <article class="dcx-ledger-kpi">
            <div class="dcx-ledger-kpi__label">Total</div>
            <div class="dcx-ledger-kpi__value">R @Model.TotalAmount.ToString("N2")</div>
        </article>
    </section>

    <section class="dcx-ledger-grid">
        <section class="dcx-ledger-panel">
            <div class="mb-3">
                <div class="dcx-kicker mb-2">Summary</div>
                <h2 class="dcx-section-heading mb-0">Employee totals</h2>
            </div>

            @if (Model.SummaryRows.Count == 0)
            {
                <p class="dcx-subtle-text mb-0">No records found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="dcx-report-table">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Orders</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.SummaryRows)
                            {
                                <tr>
                                    <td>@row.EmployeeUsername</td>
                                    <td>@row.OrderCount</td>
                                    <td>R @row.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="dcx-ledger-panel">
            <div class="mb-3">
                <div class="dcx-kicker mb-2">Detail</div>
                <h2 class="dcx-section-heading mb-0">Order detail</h2>
            </div>

            @if (Model.DetailRows.Count == 0)
            {
                <p class="dcx-subtle-text mb-0">No records found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="dcx-report-table">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Time</th>
                                <th>Item</th>
                                <th>Meal</th>
                                <th>Status</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.DetailRows)
                            {
                                <tr>
                                    <td>@order.EmployeeUsername</td>
                                    <td>@order.OrderTimeUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@order.ItemSummary</td>
                                    <td>@order.MealSlot</td>
                                    <td>@order.Status</td>
                                    <td>R @order.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
            }
        </section>
    </section>
</section>
