@page
@model DigifyCXIntranet.Pages.Finance.AuditModel
@{
    ViewData["Title"] = "Finance Audit";
}

<section class="card-elevated p-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h4 mb-1">Finance Audit Trail</h1>
            <p class="text-muted mb-0">Recent finance, canteen, payroll, and Zendesk ticket audit events.</p>
        </div>
        <a asp-page="/Finance/CanteenLedger" class="btn btn-outline-secondary">Back to Ledger</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>UTC</th><th>Actor</th><th>Action</th><th>Entity</th><th>Detail</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.TimestampUtc.ToString("dd MMM yyyy HH:mm:ss")</td>
                    <td>@item.Actor</td>
                    <td>@item.Action</td>
                    <td>@item.Entity</td>
                    <td class="text-break">@item.Detail</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
