@page
@model DigifyCXIntranet.Pages.Faq.IndexModel
@{
    ViewData["Title"] = "FAQs";
}

<!-- Main Page Container (Narrower max-w for easier reading) -->
<div class="mx-auto max-w-4xl bg-[#1e2336] rounded-2xl p-6 lg:p-8 border border-slate-700 shadow-xl">
    
    <!-- Header -->
    <div class="mb-8 border-b border-slate-700/80 pb-5 text-center">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Frequently Asked Questions</h1>
        <p class="mt-2 text-sm text-slate-400">Find quick answers to common questions about platform usage and company policies.</p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center rounded-xl bg-slate-800/30 py-12 border border-slate-700/50 border-dashed">
            <p class="text-slate-400 font-medium">No FAQs are available yet.</p>
        </div>
    }
    else
    {
        <!-- FAQ Accordion List -->
        <div class="space-y-4">
            @foreach (var item in Model.Items)
            {
                <details class="group rounded-xl border border-slate-700/60 bg-slate-800/40 shadow-inner overflow-hidden transition-all duration-300 open:bg-slate-800/80 open:border-slate-600">
                    
                    <!-- Question (Clickable Header) -->
                    <!-- Note: list-none and the webkit hidden utility strip away the ugly default browser arrow -->
                    <summary class="flex cursor-pointer list-none items-center justify-between p-5 font-semibold text-white transition-colors hover:bg-slate-700/30 [&::-webkit-details-marker]:hidden">
                        <span class="flex-grow pr-4">@item.Question</span>
                        
                        <!-- Expand/Collapse Chevron Icon -->
                        <!-- The 'group-open:rotate-180' class handles the animation automatically! -->
                        <span class="flex-shrink-0 transition-transform duration-300 group-open:rotate-180 text-cyan-400">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </summary>
                    
                    <!-- Answer Content -->
                    <div class="px-5 pb-5 pt-2">
                        <!-- Category Pill -->
                        <div class="mb-4 inline-block rounded-full border border-cyan-500/20 bg-cyan-500/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-cyan-400">
                            @item.Category
                        </div>
                        
                        <!-- Answer Text -->
                        <p class="text-sm text-slate-300 leading-relaxed">
                            @item.Answer
                        </p>
                    </div>
                    
                </details>
            }
        </div>
    }
</div>