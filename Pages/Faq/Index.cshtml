@page
@model DigifyCXIntranet.Pages.Faq.IndexModel
@{
    ViewData["Title"] = "FAQs";
}

<section class="dcx-faq-shell">
    <header class="dcx-faq-header">
        <div class="dcx-kicker mb-3">Help Center</div>
        <h1 class="dcx-faq-title">Frequently asked <span>questions</span></h1>
        <p class="dcx-faq-copy mt-3 mb-0">
            Find quick answers to common questions about platform usage and company policies.
        </p>
    </header>

    @if (Model.Items.Count == 0)
    {
        <div class="dcx-empty-state text-center">
            <img src="~/images/branding/digifycx-logo.png"
                 alt=""
                 aria-hidden="true"
                 class="dcx-empty-state__logo" />
            <p class="mb-0">No FAQs are available yet.</p>
        </div>
    }
    else
    {
        <div class="dcx-faq-stack">
            @foreach (var item in Model.Items)
            {
                <details class="dcx-faq-card">
                    <summary class="dcx-faq-card__summary">
                        <span class="dcx-faq-card__question">@item.Question</span>
                        <span class="dcx-faq-card__icon" aria-hidden="true">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </summary>

                    <div class="dcx-faq-card__body">
                        <div class="dcx-chip mb-3">@item.Category</div>
                        <p class="dcx-faq-card__answer mb-0">@item.Answer</p>
                    </div>
                </details>
            }
        </div>
        <partial name="_Pagination" model="new DigifyCXIntranet.Models.PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
    }
</section>
