@page
@model DigifyCXIntranet.Pages.Announcements.IndexModel
@{
    ViewData["Title"] = "Announcements";
}

<div>
    <section class="portal-panel">
        <div class="page-kicker mb-3">What's New</div>
        <h1 class="page-title">Business notices & <span>announcements</span></h1>
        <p class="page-copy mt-3 mb-4">Current notices from the business. Pinned updates stay near the top for quick scanning.</p>

        @if (Model.Items.Count == 0)
        {
            <div class="list-card">
                <div class="list-card-title">No announcements available right now.</div>
                <div class="list-card-meta">Check back later for business updates.</div>
            </div>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <details class="details-card" @(item.IsPinned ? "open" : "")>
                    <summary>
                        <span class="fw-bold">@item.Title</span>
                        @if (item.IsPinned)
                        {
                            <span class="meta-pill ms-2">Pinned</span>
                        }
                        <span class="d-block list-card-meta">@item.Summary · @item.PublishDateUtc.ToLocalTime().ToString("dd MMM yyyy")</span>
                    </summary>
                    <div class="details-body">
                        <p class="mb-0">@item.Content</p>
                    </div>
                </details>
            }
        }
    </section>
</div>
