@page
@model DigifyCXIntranet.Pages.Announcements.IndexModel
@{
    ViewData["Title"] = "Announcements";
}

<!-- Main Page Container -->
<div class="mx-auto max-w-5xl bg-[#1e2336] rounded-2xl p-6 lg:p-8 border border-slate-700 shadow-xl">
    
    <!-- Header -->
    <div class="mb-8 border-b border-slate-700/80 pb-5">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Business Notices & Announcements</h1>
        <p class="mt-2 text-sm text-slate-400">Stay up to date with the latest company news, policies, and operational updates.</p>
    </div>

    <!-- Empty State Handling -->
    @if (Model.Items.Count == 0)
    {
        <div class="flex flex-col items-center justify-center rounded-xl bg-slate-800/30 py-12 border border-slate-700/50 border-dashed">
            <p class="text-slate-400 font-medium">No announcements available at this time.</p>
        </div>
    }
    else
    {
        <!-- Announcements List -->
        <div class="space-y-5">
            @foreach (var item in Model.Items)
            {
                <article class="rounded-xl bg-slate-800/50 p-6 border border-slate-700/50 transition-all duration-200 hover:bg-slate-800 hover:border-slate-600 hover:shadow-md">
                    
                    <!-- Item Header: Title, Badge, and Date -->
                    <div class="flex flex-wrap items-start justify-between gap-4 mb-3">
                        <h2 class="text-lg font-bold text-white flex flex-wrap items-center gap-3">
                            @item.Title
                            
                            <!-- Pinned Badge -->
                            @if (item.IsPinned)
                            {
                                <span class="inline-flex items-center justify-center rounded-full bg-cyan-500/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-cyan-400 border border-cyan-500/20">
                                    Pinned
                                </span>
                            }
                        </h2>
                        
                        <!-- Date Pill -->
                        <span class="inline-block text-xs font-medium text-slate-400 bg-[#1e2336] px-3 py-1.5 rounded-full border border-slate-700/80 shadow-inner whitespace-nowrap">
                            @item.PublishDateUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </span>
                    </div>

                    <!-- Item Content -->
                    <div class="space-y-2">
                        <!-- Summary (Slightly highlighted text) -->
                        <p class="text-sm font-medium text-cyan-100/80">
                            @item.Summary
                        </p>
                        
                        <!-- Full Content -->
                        <div class="text-sm text-slate-400 leading-relaxed">
                            @item.Content
                        </div>
                    </div>
                    
                </article>
            }
        </div>
    }
</div>