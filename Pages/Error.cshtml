@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="dcx-canteen-panel my-4">
<h1 class="dcx-section-heading">We couldn't complete your request</h1>
<p>Please try again. If the problem continues, contact IT support and include the request ID below.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-page="/Index" class="dcx-btn">Return to home</a>
</section>
