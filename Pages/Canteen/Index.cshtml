@page
@model DigifyCXIntranet.Pages.Canteen.IndexModel
@{
    ViewData["Title"] = "Canteen";
}

<div class="mx-auto max-w-7xl grid grid-cols-1 lg:grid-cols-12 gap-6">
    <div class="lg:col-span-5">
        <section class="bg-[#1e2336] rounded-2xl p-6 lg:p-8 border border-slate-700 shadow-xl h-full">
            <div class="mb-6 border-b border-slate-700/80 pb-4">
                <h1 class="text-2xl font-extrabold text-white tracking-tight">Canteen Menu</h1>
                <p class="mt-1 text-xs text-slate-400">Select a menu card to place your order.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="mb-4 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-400"></div>
            }

            <form method="post" asp-page-handler="Submit">
                <div class="space-y-3 max-h-[520px] overflow-auto pr-1">
                @foreach (var item in Model.MenuItems)
                {
                    <label class="flex cursor-pointer items-center gap-4 rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-3 hover:border-cyan-500/50 transition">
                        <input type="radio" name="SelectedMenuItemId" value="@item.Id" class="h-4 w-4 text-cyan-500" />
                        <span class="text-3xl">@item.Emoji</span>
                        <span class="flex-1">
                            <span class="block text-sm font-semibold text-white">@item.Name</span>
                            <span class="text-xs text-slate-400">@item.MealSlot</span>
                        </span>
                        <span class="text-sm font-mono text-cyan-300">R @item.Price.ToString("N2")</span>
                    </label>
                }
                </div>
                <button type="submit" class="mt-5 w-full inline-flex items-center justify-center rounded-xl bg-cyan-600 px-6 py-3 text-sm font-bold tracking-wide text-white hover:bg-cyan-500 transition-all duration-200">
                    Place Order
                </button>
            </form>
        </section>
    </div>

    <div class="lg:col-span-7 flex flex-col gap-6">
        <section class="bg-[#1e2336] rounded-2xl p-6 border border-slate-700 shadow-xl">
            <h2 class="text-lg font-bold text-white mb-4">My Monthly Tallies</h2>
            @if (Model.MonthlyTallies.Count == 0)
            {
                <p class="text-slate-400 text-sm">No canteen activity recorded yet.</p>
            }
            else
            {
                <div class="overflow-hidden rounded-xl border border-slate-700/60 bg-slate-800/40 shadow-inner">
                    <table class="w-full text-left text-sm text-slate-300">
                        <thead class="bg-slate-800/80 text-xs uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-700/60">
                            <tr>
                                <th class="px-5 py-3">Month</th>
                                <th class="px-5 py-3 text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700/50">
                        @foreach (var item in Model.MonthlyTallies)
                        {
                            <tr>
                                <td class="px-5 py-3 text-white">@(new DateTime(item.Year, item.Month, 1).ToString("MMMM yyyy"))</td>
                                <td class="px-5 py-3 text-right text-cyan-300 font-mono">R @item.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="bg-[#1e2336] rounded-2xl p-6 border border-slate-700 shadow-xl flex-grow">
            <h2 class="text-lg font-bold text-white mb-4">My Recent Orders</h2>
            @if (Model.MyOrders.Count == 0)
            {
                <p class="text-slate-400 text-sm">No orders submitted yet.</p>
            }
            else
            {
                <div class="overflow-hidden rounded-xl border border-slate-700/60 bg-slate-800/40 shadow-inner overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-300 min-w-[560px]">
                        <thead class="bg-slate-800/80 text-xs uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-700/60">
                            <tr>
                                <th class="px-5 py-3">Time</th>
                                <th class="px-5 py-3">Item</th>
                                <th class="px-5 py-3">Meal</th>
                                <th class="px-5 py-3 text-center">Status</th>
                                <th class="px-5 py-3 text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700/50">
                        @foreach (var order in Model.MyOrders)
                        {
                            <tr>
                                <td class="px-5 py-3 text-slate-400 text-xs">@order.OrderTimeUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td class="px-5 py-3 text-white">@order.ItemSummary</td>
                                <td class="px-5 py-3 text-slate-300">@order.MealSlot</td>
                                <td class="px-5 py-3 text-center">@order.Status</td>
                                <td class="px-5 py-3 text-right text-cyan-300 font-mono">R @order.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
