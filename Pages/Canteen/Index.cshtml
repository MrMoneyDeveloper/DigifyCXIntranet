@page
@model DigifyCXIntranet.Pages.Canteen.IndexModel
@{
    ViewData["Title"] = "Canteen";
}

<section class="hero-panel mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-4">
        <div>
            <div class="page-kicker mb-3">Canteen</div>
            <h1 class="page-title">Choose your <span>next meal</span></h1>
            <p class="page-copy mt-3 mb-0">Browse available breakfast and lunch items, then expand your account section when you need order history or monthly totals.</p>
        </div>
    </div>
</section>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<div class="portal-grid">
    <section class="soft-card">
        <form method="post" asp-page-handler="Submit">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h2 class="section-title mb-0">Menu</h2>
                <button type="submit" class="btn btn-primary">Place Order</button>
            </div>

            @if (Model.MenuItems.Count == 0)
            {
                <p class="text-muted mb-0">No menu items are active right now.</p>
            }
            else
            {
                <div class="menu-grid">
                    @foreach (var group in Model.MenuItems.GroupBy(x => x.MealSlot))
                    {
                        foreach (var item in group)
                        {
                            <label class="menu-card">
                                <input type="radio" name="SelectedMenuItemId" value="@item.Id" />
                                @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.Name" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center rounded-4 bg-light" style="aspect-ratio:16/10;font-size:3rem;">@item.Emoji</div>
                                }
                                <span class="d-flex align-items-start justify-content-between gap-3">
                                    <span>
                                        <span class="d-block fw-bold">@item.Name</span>
                                        <span class="list-card-meta">@item.MealSlot</span>
                                    </span>
                                    <span class="fw-bold text-nowrap">R @item.Price.ToString("N2")</span>
                                </span>
                            </label>
                        }
                    }
                </div>
            }
        </form>
    </section>

    <aside class="soft-card">
        <h2 class="section-title">My Canteen Account</h2>

        <details class="details-card" open>
            <summary>
                <span class="fw-bold">Monthly totals</span>
                <span class="d-block list-card-meta">Quick view of recent canteen spend</span>
            </summary>
            <div class="details-body">
                @if (Model.MonthlyTallies.Count == 0)
                {
                    <p class="text-muted mb-0">No canteen activity recorded yet.</p>
                }
                else
                {
                    <div class="d-grid gap-2">
                        @foreach (var item in Model.MonthlyTallies)
                        {
                            <div class="list-card">
                                <div class="d-flex justify-content-between gap-3">
                                    <span class="fw-bold">@(new DateTime(item.Year, item.Month, 1).ToString("MMMM yyyy"))</span>
                                    <span class="fw-bold">R @item.TotalAmount.ToString("N2")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </details>

        <details class="details-card">
            <summary>
                <span class="fw-bold">Recent orders</span>
                <span class="d-block list-card-meta">Expand for item-level detail</span>
            </summary>
            <div class="details-body">
                @if (Model.MyOrders.Count == 0)
                {
                    <p class="text-muted mb-0">No orders submitted yet.</p>
                }
                else
                {
                    foreach (var order in Model.MyOrders)
                    {
                        <article class="list-card">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <div class="fw-bold">@order.ItemSummary</div>
                                    <div class="list-card-meta">@order.MealSlot · @order.OrderTimeUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold">R @order.TotalAmount.ToString("N2")</div>
                                    <div class="list-card-meta">@order.Status</div>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </details>
    </aside>
</div>
