@page
@model DigifyCXIntranet.Pages.Canteen.IndexModel
@{
    ViewData["Title"] = "Canteen";
}

<div class="mx-auto max-w-7xl grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- Left Column: Form -->
    <div class="lg:col-span-5">
        <section class="bg-[#1e2336] rounded-2xl p-6 lg:p-8 border border-slate-700 shadow-xl h-full">
            <div class="mb-6 border-b border-slate-700/80 pb-4">
                <h1 class="text-2xl font-extrabold text-white tracking-tight">Submit Canteen Request</h1>
                <p class="mt-1 text-xs text-slate-400">Orders are recorded for employee visibility and payroll reconciliation.</p>
            </div>

            <form method="post" asp-page-handler="Submit" class="space-y-5">
                <!-- Item Summary -->
                <div>
                    <label asp-for="NewOrder.ItemSummary" class="block text-sm font-semibold text-slate-300 mb-1.5">Item Summary</label>
                    <input asp-for="NewOrder.ItemSummary" class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition" placeholder="e.g., Chicken Wrap & Soda" />
                    <span asp-validation-for="NewOrder.ItemSummary" class="text-xs font-medium text-red-400 mt-1 block"></span>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <!-- Order Date -->
                    <div>
                        <label asp-for="NewOrder.OrderDate" class="block text-sm font-semibold text-slate-300 mb-1.5">Order Date</label>
                        <!-- Note: Adding color-scheme: dark ensures the native browser calendar popup is dark themed! -->
                        <input asp-for="NewOrder.OrderDate" type="date" class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-2.5 text-sm text-white focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition [color-scheme:dark]" />
                        <span asp-validation-for="NewOrder.OrderDate" class="text-xs font-medium text-red-400 mt-1 block"></span>
                    </div>
                    
                    <!-- Total Amount -->
                    <div>
                        <label asp-for="NewOrder.TotalAmount" class="block text-sm font-semibold text-slate-300 mb-1.5">Total Amount</label>
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                                <span class="text-slate-400 sm:text-sm font-medium">R</span>
                            </div>
                            <input asp-for="NewOrder.TotalAmount" type="number" step="0.01" class="w-full rounded-xl border border-slate-600 bg-slate-800/50 pl-8 pr-4 py-2.5 text-sm text-white focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="NewOrder.TotalAmount" class="text-xs font-medium text-red-400 mt-1 block"></span>
                    </div>
                </div>

                <!-- Employment Months -->
                <div>
                    <label asp-for="NewOrder.EmploymentMonthsAtOrder" class="block text-sm font-semibold text-slate-300 mb-1.5">Months Employed</label>
                    <input asp-for="NewOrder.EmploymentMonthsAtOrder" type="number" class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-2.5 text-sm text-white focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 transition" placeholder="Months employed" />
                    <span asp-validation-for="NewOrder.EmploymentMonthsAtOrder" class="text-xs font-medium text-red-400 mt-1 block"></span>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button type="submit" class="w-full inline-flex items-center justify-center rounded-xl bg-cyan-600 px-6 py-3 text-sm font-bold tracking-wide text-white shadow-sm hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all duration-200">
                        Submit Order
                    </button>
                </div>
            </form>
        </section>
    </div>

    <!-- Right Column: Data Tables -->
    <div class="lg:col-span-7 flex flex-col gap-6">
        
        <!-- Monthly Tallies Section -->
        <section class="bg-[#1e2336] rounded-2xl p-6 border border-slate-700 shadow-xl">
            <h2 class="text-lg font-bold text-white mb-4">My Monthly Tallies</h2>
            
            @if (Model.MonthlyTallies.Count == 0)
            {
                <div class="flex flex-col items-center justify-center rounded-xl bg-slate-800/30 py-8 border border-slate-700/50 border-dashed">
                    <p class="text-slate-400 text-sm font-medium">No canteen activity recorded yet.</p>
                </div>
            }
            else
            {
                <div class="overflow-hidden rounded-xl border border-slate-700/60 bg-slate-800/40 shadow-inner">
                    <table class="w-full text-left text-sm text-slate-300">
                        <thead class="bg-slate-800/80 text-xs uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-700/60">
                            <tr>
                                <th class="px-5 py-3">Month</th>
                                <th class="px-5 py-3 text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700/50">
                            @foreach (var item in Model.MonthlyTallies)
                            {
                                <tr class="hover:bg-slate-700/30 transition-colors duration-150">
                                    <td class="px-5 py-3 font-medium text-white">@(new DateTime(item.Year, item.Month, 1).ToString("MMMM yyyy"))</td>
                                    <td class="px-5 py-3 text-right text-cyan-300 font-mono">R @item.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- Recent Orders Section -->
        <section class="bg-[#1e2336] rounded-2xl p-6 border border-slate-700 shadow-xl flex-grow">
            <h2 class="text-lg font-bold text-white mb-4">My Recent Orders</h2>
            
            @if (Model.MyOrders.Count == 0)
            {
                <div class="flex flex-col items-center justify-center rounded-xl bg-slate-800/30 py-10 border border-slate-700/50 border-dashed">
                    <p class="text-slate-400 text-sm font-medium">No orders submitted yet.</p>
                </div>
            }
            else
            {
                <div class="overflow-hidden rounded-xl border border-slate-700/60 bg-slate-800/40 shadow-inner overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-300 min-w-[500px]">
                        <thead class="bg-slate-800/80 text-xs uppercase tracking-wider text-slate-400 font-semibold border-b border-slate-700/60">
                            <tr>
                                <th class="px-5 py-3">Date</th>
                                <th class="px-5 py-3">Item</th>
                                <th class="px-5 py-3 text-center">Status</th>
                                <th class="px-5 py-3 text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700/50">
                            @foreach (var order in Model.MyOrders)
                            {
                                <tr class="hover:bg-slate-700/30 transition-colors duration-150">
                                    <td class="px-5 py-3 whitespace-nowrap text-slate-400 text-xs">@order.OrderDate.ToString("dd MMM yyyy")</td>
                                    <td class="px-5 py-3 font-medium text-white">@order.ItemSummary</td>
                                    <td class="px-5 py-3 text-center">
                                        <span class="inline-flex rounded-full bg-slate-700/50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-300 border border-slate-600">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="px-5 py-3 text-right text-cyan-300 font-mono whitespace-nowrap">R @order.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}