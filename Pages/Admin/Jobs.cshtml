@page
@model DigifyCXIntranet.Pages.Admin.JobsModel
@{
    ViewData["Title"] = "Manage Jobs";
}

<section class="dcx-admin-manage-shell">
    <header class="dcx-admin-manage-header">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a asp-page="/Admin/Index" class="dcx-icon-back" title="Back to Dashboard" aria-label="Back to Dashboard">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>

            <div>
                <div class="dcx-kicker mb-2">Talent</div>
                <h1 class="dcx-admin-manage-title">Manage job postings</h1>
            </div>
        </div>
    </header>

    <div class="dcx-admin-manage-grid">
        <div class="dcx-admin-form-panel">
            <div class="dcx-admin-form-panel__head">
                <div>
                    <div class="dcx-kicker mb-2">Create</div>
                    <h2 class="dcx-section-heading mb-0">Create job posting</h2>
                </div>
            </div>

            <form method="post" asp-page-handler="Create" enctype="multipart/form-data" class="dcx-admin-form">
                <div>
                    <label asp-for="NewItem.Title" class="dcx-label mb-2"></label>
                    <input asp-for="NewItem.Title" class="dcx-input" placeholder="e.g., Senior Developer" />
                    <span asp-validation-for="NewItem.Title" class="dcx-field-error mt-1"></span>
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="NewItem.Department" class="dcx-label mb-2"></label>
                        <input asp-for="NewItem.Department" class="dcx-input" />
                        <span asp-validation-for="NewItem.Department" class="dcx-field-error mt-1"></span>
                    </div>

                    <div class="col-sm-6">
                        <label asp-for="NewItem.ClosingDate" class="dcx-label mb-2"></label>
                        <input asp-for="NewItem.ClosingDate" type="date" class="dcx-input" />
                    </div>
                </div>

                <div>
                    <label asp-for="NewItem.ApplicationRoute" class="dcx-label mb-2"></label>
                    <input asp-for="NewItem.ApplicationRoute"
                           class="dcx-input dcx-code-input"
                           placeholder="hr@digifycx.example" />
                    <span asp-validation-for="NewItem.ApplicationRoute" class="dcx-field-error mt-1"></span>
                </div>

                <div>
                    <label asp-for="NewItem.Description" class="dcx-label mb-2"></label>
                    <textarea asp-for="NewItem.Description" rows="4" class="dcx-textarea"></textarea>
                    <span asp-validation-for="NewItem.Description" class="dcx-field-error mt-1"></span>
                </div>

                <div class="dcx-admin-check-group">
                    <label class="dcx-admin-check__label">
                        <input asp-for="NewItem.IsExternalReferral" class="dcx-admin-check__input" />
                        <span class="dcx-admin-check__box">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        </span>
                        <span class="dcx-admin-check__text">Enable external referral workflow</span>
                    </label>
                </div>

                <section class="dcx-jobs-visual-panel">
                    <div class="dcx-jobs-visual-panel__head">
                        <h3 class="dcx-jobs-visual-panel__title">Visual ad setup</h3>

                        <label class="dcx-admin-check__label">
                            <input asp-for="NewItem.UseVisualAd" class="dcx-admin-check__input" />
                            <span class="dcx-admin-check__box">
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </span>
                            <span class="dcx-admin-check__text">Use A4 format</span>
                        </label>
                    </div>

                    <div class="dcx-jobs-visual-grid">
                        <div class="dcx-jobs-visual-grid__full">
                            <label asp-for="NewItem.AdHeadline" class="dcx-label mb-2">Ad Headline</label>
                            <input asp-for="NewItem.AdHeadline" class="dcx-input" />
                            <span asp-validation-for="NewItem.AdHeadline" class="dcx-field-error mt-1"></span>
                        </div>

                        <div class="dcx-jobs-visual-grid__full">
                            <label asp-for="NewItem.AdSubHeadline" class="dcx-label mb-2">Ad Subheadline</label>
                            <textarea asp-for="NewItem.AdSubHeadline" rows="2" class="dcx-textarea"></textarea>
                            <span asp-validation-for="NewItem.AdSubHeadline" class="dcx-field-error mt-1"></span>
                        </div>

                        <div class="dcx-jobs-visual-grid__full">
                            <label asp-for="AdBackgroundUpload" class="dcx-label mb-2">Ad Background Image</label>
                            <input asp-for="AdBackgroundUpload"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   class="dcx-file-input" />
                            <span asp-validation-for="AdBackgroundUpload" class="dcx-field-error mt-1"></span>

                            <div class="dcx-jobs-template-note">
                                <img src="/images/job-ad-a4-template.svg"
                                     alt="Template"
                                     class="dcx-jobs-template-note__thumb" />
                                <p class="dcx-subtle-text mb-0">
                                    If omitted, the default template will be used. Please upload A4 portrait format images.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <button type="submit" class="dcx-admin-submit">Publish Job</button>
            </form>
        </div>

        <section class="dcx-admin-table-panel">
            <div class="dcx-admin-table-panel__head">
                <div>
                    <div class="dcx-kicker mb-2">Listings</div>
                    <h2 class="dcx-section-heading mb-0">Current job postings</h2>
                </div>

                <span class="dcx-admin-count-pill">@Model.TotalCount Total</span>
            </div>

            <div class="table-responsive">
                <table class="dcx-report-table">
                    <thead>
                        <tr>
                            <th>Title / Dept</th>
                            <th>Format</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="dcx-job-cell">
                                        <div class="dcx-job-cell__title">@item.Title</div>
                                        <div class="dcx-job-cell__meta">@item.Department</div>
                                    </div>
                                </td>
                                <td>
                                    @if (item.UseVisualAd)
                                    {
                                        <span class="dcx-format-pill dcx-format-pill--visual">A4 Ad</span>
                                    }
                                    else
                                    {
                                        <span class="dcx-format-pill dcx-format-pill--standard">Standard</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="dcx-status-pill dcx-status-pill--success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="dcx-status-pill dcx-status-pill--muted">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="dcx-admin-actions-inline">
                                        <a asp-page="/Admin/JobEdit"
                                           asp-route-id="@item.Id"
                                           class="dcx-mini-btn dcx-mini-btn--edit">
                                            Edit
                                        </a>

                                        <form method="post" asp-page-handler="ToggleActive" class="m-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="dcx-mini-btn dcx-mini-btn--neutral">
                                                @(item.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>

                                        @if (!item.IsActive)
                                        {
                                            <form method="post" asp-page-handler="Delete" class="m-0">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="dcx-mini-btn dcx-mini-btn--danger">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="new PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
