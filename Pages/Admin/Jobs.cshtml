@page
@model DigifyCXIntranet.Pages.Admin.JobsModel
@{
    ViewData["Title"] = "Manage Jobs";
}

<div class="row g-4">
    <div class="col-lg-5">
        <section class="card-elevated p-4">
            <h1 class="h5 mb-3">Create Job Posting</h1>
            <form method="post" asp-page-handler="Create" enctype="multipart/form-data" class="row g-3">
                <div class="col-12">
                    <label asp-for="NewItem.Title" class="form-label"></label>
                    <input asp-for="NewItem.Title" class="form-control" />
                    <span asp-validation-for="NewItem.Title" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="NewItem.Department" class="form-label"></label>
                    <input asp-for="NewItem.Department" class="form-control" />
                    <span asp-validation-for="NewItem.Department" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="NewItem.ApplicationRoute" class="form-label"></label>
                    <input asp-for="NewItem.ApplicationRoute" class="form-control" />
                    <span asp-validation-for="NewItem.ApplicationRoute" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="NewItem.ClosingDate" class="form-label"></label>
                    <input asp-for="NewItem.ClosingDate" type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="NewItem.Description" class="form-label"></label>
                    <textarea asp-for="NewItem.Description" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="NewItem.Description" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="NewItem.UseVisualAd" class="form-check-input" />
                        <label asp-for="NewItem.UseVisualAd" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="NewItem.AdHeadline" class="form-label">Ad Headline</label>
                    <input asp-for="NewItem.AdHeadline" class="form-control" />
                    <span asp-validation-for="NewItem.AdHeadline" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="NewItem.AdSubHeadline" class="form-label">Ad Subheadline</label>
                    <textarea asp-for="NewItem.AdSubHeadline" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="NewItem.AdSubHeadline" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="AdBackgroundUpload" class="form-label">Ad Background Image (A4 portrait)</label>
                    <input asp-for="AdBackgroundUpload" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                    <span asp-validation-for="AdBackgroundUpload" class="text-danger"></span>
                    <div class="small text-muted mt-1">If omitted, the default template image is used.</div>
                    <div class="mt-2">
                        <img src="/images/job-ad-a4-template.svg" alt="Default job ad template" style="max-height:220px;" class="rounded border" />
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="NewItem.IsExternalReferral" class="form-check-input" />
                        <label asp-for="NewItem.IsExternalReferral" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="card-elevated p-4">
            <h2 class="h6 mb-3">Current Job Postings</h2>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Department</th>
                            <th>Ad Format</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.Department</td>
                            <td>@(item.UseVisualAd ? "A4 Ad" : "Standard")</td>
                            <td>@(item.IsActive ? "Active" : "Inactive")</td>
                            <td class="text-nowrap">
                                <a asp-page="/Admin/JobEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form method="post" asp-page-handler="ToggleActive" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
