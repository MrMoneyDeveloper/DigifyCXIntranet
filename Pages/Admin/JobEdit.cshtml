@page "{id:int}"
@model DigifyCXIntranet.Pages.Admin.JobEditModel
@{
    ViewData["Title"] = "Edit Job Posting";
}

<section class="dcx-admin-edit-shell dcx-job-edit-shell">
    <header class="dcx-admin-manage-header">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a asp-page="/Admin/Jobs" class="dcx-icon-back" title="Back to Jobs" aria-label="Back to Jobs">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>

            <div>
                <div class="dcx-kicker mb-2">Talent</div>
                <h1 class="dcx-admin-manage-title">Edit job posting</h1>
                <p class="dcx-admin-edit-copy mb-0 mt-2">
                    Update job details, requirements, and visual ad configurations.
                </p>
            </div>
        </div>
    </header>

    <section class="dcx-admin-edit-panel">
        <form method="post" enctype="multipart/form-data" class="row g-4">
            <input asp-for="Item.Id" type="hidden" />
            <input asp-for="Item.AdBackgroundImagePath" type="hidden" />

            <div class="col-md-6">
                <label asp-for="Item.Title" class="dcx-label mb-2"></label>
                <input asp-for="Item.Title" class="dcx-input" />
                <span asp-validation-for="Item.Title" class="dcx-field-error mt-1"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Item.Department" class="dcx-label mb-2"></label>
                <input asp-for="Item.Department" class="dcx-input" />
            </div>

            <div class="col-md-6">
                <label asp-for="Item.ApplicationRoute" class="dcx-label mb-2"></label>
                <input asp-for="Item.ApplicationRoute" class="dcx-input dcx-code-input" />
            </div>

            <div class="col-md-6">
                <label asp-for="Item.ClosingDate" class="dcx-label mb-2"></label>
                <input asp-for="Item.ClosingDate" type="date" class="dcx-input" />
            </div>

            <div class="col-12">
                <label asp-for="Item.Description" class="dcx-label mb-2"></label>
                <textarea asp-for="Item.Description" rows="6" class="dcx-textarea"></textarea>
                <span asp-validation-for="Item.Description" class="dcx-field-error mt-1"></span>
            </div>

            <div class="col-12">
                <section class="dcx-jobs-visual-panel">
                    <div class="dcx-jobs-visual-panel__head">
                        <h3 class="dcx-jobs-visual-panel__title">Visual ad setup</h3>

                        <label class="dcx-admin-check__label">
                            <input asp-for="Item.UseVisualAd" class="dcx-admin-check__input" />
                            <span class="dcx-admin-check__box">
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </span>
                            <span class="dcx-admin-check__text">Use A4 format</span>
                        </label>
                    </div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="Item.AdHeadline" class="dcx-label mb-2">Ad Headline</label>
                            <input asp-for="Item.AdHeadline" class="dcx-input" />
                            <span asp-validation-for="Item.AdHeadline" class="dcx-field-error mt-1"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Item.AdSubHeadline" class="dcx-label mb-2">Ad Subheadline</label>
                            <textarea asp-for="Item.AdSubHeadline" rows="2" class="dcx-textarea"></textarea>
                            <span asp-validation-for="Item.AdSubHeadline" class="dcx-field-error mt-1"></span>
                        </div>

                        <div class="col-12">
                            <div class="dcx-job-image-replace">
                                <div class="dcx-job-image-replace__preview">
                                    <img src="@Model.Item.AdBackgroundImagePath"
                                         alt="Current background preview"
                                         class="dcx-job-image-replace__img" />
                                    <div class="dcx-job-image-replace__caption"
                                         title="@Model.Item.AdBackgroundImagePath">
                                        Current image
                                    </div>
                                </div>

                                <div class="dcx-job-image-replace__form">
                                    <label asp-for="AdBackgroundUpload" class="dcx-label mb-2">Replace Background Image</label>
                                    <input asp-for="AdBackgroundUpload"
                                           type="file"
                                           accept=".jpg,.jpeg,.png,.webp"
                                           class="dcx-file-input" />
                                    <span asp-validation-for="AdBackgroundUpload" class="dcx-field-error mt-1"></span>
                                    <p class="dcx-subtle-text mb-0 mt-2">
                                        Upload a new A4 portrait image to replace the current one. Accepted formats: JPG, PNG, WEBP.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-12">
                <div class="dcx-job-edit-flags">
                    <label class="dcx-admin-check__label">
                        <input asp-for="Item.IsExternalReferral" class="dcx-admin-check__input" />
                        <span class="dcx-admin-check__box">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        </span>
                        <span class="dcx-admin-check__text">Enable external referral</span>
                    </label>

                    <label class="dcx-admin-check__label">
                        <input asp-for="Item.IsActive" class="dcx-admin-check__input" />
                        <span class="dcx-admin-check__box">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        </span>
                        <span class="dcx-admin-check__text">Job is Active</span>
                    </label>
                </div>
            </div>

            <div class="col-12">
                <div class="dcx-admin-edit-actions">
                    <button type="submit" class="dcx-admin-submit">Save Changes</button>
                    <a asp-page="/Admin/Jobs" class="dcx-btn-ghost">Cancel</a>
                </div>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}