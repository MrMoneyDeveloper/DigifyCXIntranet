@page
@model DigifyCXIntranet.Pages.Admin.PoliciesModel
@{
    ViewData["Title"] = "Policy Sync";
}

<section class="dcx-policy-sync-shell">
    <header class="dcx-policy-sync-header">
        <div>
            <div class="dcx-kicker mb-3">Zendesk Master</div>
            <h1 class="dcx-policy-sync-title">Policy sync <span>status</span></h1>
            <p class="dcx-policy-sync-copy mt-3 mb-0">
                Policies remain managed in Zendesk. This page shows sync health and cached article groups without exposing credentials.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <form method="post" asp-page-handler="SyncNow" class="m-0">
                <button type="submit" class="dcx-btn">Sync Now</button>
            </form>
            <a asp-page="/Policies/ComplianceReport" class="dcx-btn-secondary">Compliance</a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SyncMessage))
    {
        <div class="dcx-inline-alert dcx-inline-alert--success">
            @Model.SyncMessage
        </div>
    }

    <section class="dcx-policy-sync-kpis">
        <article class="dcx-policy-sync-kpi">
            <div class="dcx-policy-sync-kpi__label">Zendesk subdomain</div>
            <div class="dcx-policy-sync-kpi__value">@Model.ConfiguredSubdomain</div>
        </article>

        <article class="dcx-policy-sync-kpi">
            <div class="dcx-policy-sync-kpi__label">HR ticket form</div>
            <div class="dcx-policy-sync-kpi__value">Configured</div>
        </article>

        <article class="dcx-policy-sync-kpi">
            <div class="dcx-policy-sync-kpi__label">API access</div>
            <div class="dcx-policy-sync-kpi__value">@(Model.TokenConfigured ? "Ready" : "Missing")</div>
        </article>
    </section>

    <section class="dcx-policy-sync-grid">
        <section class="dcx-policy-sync-panel">
            <div class="mb-3">
                <div class="dcx-kicker mb-2">Monitoring</div>
                <h2 class="dcx-section-heading mb-0">Recent sync results</h2>
            </div>

            @if (Model.RecentSyncLogs.Count == 0)
            {
                <p class="dcx-subtle-text mb-0">No sync attempts recorded yet.</p>
            }
            else
            {
                <div class="dcx-sync-log-list">
                    @foreach (var log in Model.RecentSyncLogs)
                    {
                        <article class="dcx-sync-log-card">
                            <div class="d-flex justify-content-between gap-3 flex-wrap">
                                <div>
                                    <div class="dcx-sync-log-card__title">@(log.Succeeded ? "Sync completed" : "Sync failed")</div>
                                    <div class="dcx-sync-log-card__meta">
                                        @log.StartedUtc.ToString("dd MMM yyyy HH:mm") · @log.ItemsProcessed article(s)
                                    </div>
                                </div>

                                @if (log.Succeeded)
                                {
                                    <span class="dcx-status-pill dcx-status-pill--success">Healthy</span>
                                }
                                else
                                {
                                    <span class="dcx-status-pill dcx-status-pill--danger">Check</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(log.Message))
                            {
                                <div class="dcx-sync-log-card__meta mt-2">@log.Message</div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="dcx-policy-sync-panel">
            <div class="mb-3">
                <div class="dcx-kicker mb-2">Cache</div>
                <h2 class="dcx-section-heading mb-0">Cached articles</h2>
            </div>

            @if (Model.Items.Count == 0)
            {
                <p class="dcx-subtle-text mb-0">No Zendesk articles are cached yet.</p>
            }
            else
            {
                <div class="dcx-cache-group-list">
                    @foreach (var group in Model.Items.GroupBy(x => string.IsNullOrWhiteSpace(x.SectionName) ? "General" : x.SectionName))
                    {
                        <details class="dcx-cache-group">
                            <summary>
                                <span>
                                    <span class="dcx-cache-group__title">@group.Key</span>
                                    <span class="dcx-cache-group__meta">@group.Count() article(s)</span>
                                </span>
                            </summary>

                            <div class="dcx-cache-group__body">
                                @foreach (var item in group)
                                {
                                    <a href="@item.HtmlUrl"
                                       target="_blank"
                                       rel="noreferrer noopener"
                                       class="dcx-cache-article">
                                        <div class="dcx-cache-article__title">@item.Title</div>
                                        <div class="dcx-cache-article__meta">
                                            @(item.IsPublished ? "Published" : "Draft") · Updated @item.UpdatedAtUtc.ToString("dd MMM yyyy")
                                        </div>
                                    </a>
                                }
                            </div>
                        </details>
                    }
                </div>
                <partial name="_Pagination" model="new DigifyCXIntranet.Models.PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
            }
        </section>
    </section>
</section>
