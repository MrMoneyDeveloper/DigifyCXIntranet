@page
@model DigifyCXIntranet.Pages.Admin.PoliciesModel
@{
    ViewData["Title"] = "Policy Sync";
}

<div class="card-elevated p-4 mb-4">
    <h1 class="h4 mb-2">Policy Sync (Zendesk Master)</h1>
    <p class="text-muted mb-0">Policies are read from the Zendesk Help Center cache. Local policy editing is disabled.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SyncMessage))
{
    <div class="alert alert-success">@Model.SyncMessage</div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <form method="post" asp-page-handler="SyncNow" class="m-0">
        <button type="submit" class="btn btn-primary">Sync From Zendesk Now</button>
    </form>
    <a asp-page="/Policies/ComplianceReport" class="btn btn-outline-primary">Open Compliance Report</a>
</div>

<div class="card-elevated p-3">
    @if (Model.Items.Count == 0)
    {
        <p class="text-muted mb-0">No Zendesk articles are cached yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Version</th>
                        <th>Updated UTC</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.VersionLabel</td>
                        <td>@item.UpdatedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@(item.IsPublished ? "Published" : "Draft")</td>
                        <td><a href="@item.HtmlUrl" target="_blank" rel="noreferrer noopener" class="btn btn-sm btn-outline-secondary">Open Zendesk</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
