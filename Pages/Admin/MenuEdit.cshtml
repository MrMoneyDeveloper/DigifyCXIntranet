@page "{id:int}"
@model DigifyCXIntranet.Pages.Admin.MenuEditModel
@{
    ViewData["Title"] = "Edit Menu Item";
}

<section class="dcx-admin-edit-shell dcx-menu-edit-shell">
    <header class="dcx-admin-manage-header">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a asp-page="/Admin/Menu" class="dcx-icon-back" title="Back to Menu" aria-label="Back to Menu">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>

            <div>
                <div class="dcx-kicker mb-2">Canteen</div>
                <h1 class="dcx-admin-manage-title">Edit menu item</h1>
                <p class="dcx-admin-edit-copy mb-0 mt-2">
                    Update canteen item details, display order, status, and food image.
                </p>
            </div>
        </div>
    </header>

    <section class="dcx-admin-edit-panel">
        <form method="post" enctype="multipart/form-data" class="row g-4">
            <input asp-for="Item.Id" type="hidden" />
            <input asp-for="Item.ImagePath" type="hidden" />

            <div class="col-md-6">
                <label asp-for="Item.Name" class="dcx-label mb-2"></label>
                <input asp-for="Item.Name" class="dcx-input" />
                <span asp-validation-for="Item.Name" class="dcx-field-error mt-1"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Item.Price" class="dcx-label mb-2"></label>
                <input asp-for="Item.Price" type="number" step="0.01" class="dcx-input" />
            </div>

            <div class="col-md-3">
                <label asp-for="Item.MealSlot" class="dcx-label mb-2"></label>
                <select asp-for="Item.MealSlot"
                        asp-items="Html.GetEnumSelectList<DigifyCXIntranet.Models.MealSlot>()"
                        class="dcx-input dcx-input-select"></select>
            </div>

            <div class="col-md-3">
                <label asp-for="Item.Emoji" class="dcx-label mb-2"></label>
                <input asp-for="Item.Emoji" class="dcx-input" />
            </div>

            <div class="col-md-3">
                <label asp-for="Item.DisplayOrder" class="dcx-label mb-2"></label>
                <input asp-for="Item.DisplayOrder" type="number" class="dcx-input" />
            </div>

            <div class="col-md-3">
                <label asp-for="Item.IconClass" class="dcx-label mb-2"></label>
                <input asp-for="Item.IconClass" class="dcx-input dcx-code-input" />
            </div>

            <div class="col-md-3 d-flex align-items-center">
                <label class="dcx-admin-check__label">
                    <input asp-for="Item.IsActive" class="dcx-admin-check__input" />
                    <span class="dcx-admin-check__box">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </span>
                    <span class="dcx-admin-check__text">Item is Active</span>
                </label>
            </div>

            <div class="col-12">
                <div class="dcx-menu-image-edit">
                    <div class="dcx-menu-image-edit__preview">
                        <label class="dcx-label mb-2">Current Image</label>

                        @if (!string.IsNullOrWhiteSpace(Model.Item.ImagePath))
                        {
                            <img src="@Model.Item.ImagePath"
                                 alt="@Model.Item.Name"
                                 class="dcx-menu-image-edit__img" />
                        }
                        else
                        {
                            <div class="dcx-menu-image-edit__empty">No image uploaded.</div>
                        }
                    </div>

                    <div class="dcx-menu-image-edit__upload">
                        <label asp-for="FoodImageUpload" class="dcx-label mb-2">Replace Food Image</label>
                        <input asp-for="FoodImageUpload"
                               type="file"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="dcx-file-input" />
                        <span asp-validation-for="FoodImageUpload" class="dcx-field-error mt-1"></span>
                        <div class="dcx-subtle-text mt-2">Accepted formats: JPG, PNG, WEBP. Maximum 3MB.</div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="dcx-admin-edit-actions">
                    <button type="submit" class="dcx-admin-submit">Save Changes</button>
                    <a asp-page="/Admin/Menu" class="dcx-btn-ghost">Cancel</a>
                </div>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}