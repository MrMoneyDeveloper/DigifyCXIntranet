@page
@model DigifyCXIntranet.Pages.Admin.AnnouncementsModel
@{
    ViewData["Title"] = "Manage Announcements";
}

<section class="dcx-admin-manage-shell">
    <header class="dcx-admin-manage-header">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a asp-page="/Admin/Index" class="dcx-icon-back" title="Back to Dashboard" aria-label="Back to Dashboard">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>

            <div>
                <div class="dcx-kicker mb-2">Admin Console</div>
                <h1 class="dcx-admin-manage-title">Manage announcements</h1>
            </div>
        </div>
    </header>

    <div class="dcx-admin-manage-grid">
        <section class="dcx-admin-form-panel">
            <div class="dcx-admin-form-panel__head">
                <div>
                    <div class="dcx-kicker mb-2">Create</div>
                    <h2 class="dcx-section-heading mb-0">Create announcement</h2>
                </div>
            </div>

            <form method="post" asp-page-handler="Create" class="dcx-admin-form">
                <div>
                    <label asp-for="NewItem.Title" class="dcx-label mb-2"></label>
                    <input asp-for="NewItem.Title" class="dcx-input" placeholder="e.g., Monthly Townhall" />
                    <span asp-validation-for="NewItem.Title" class="dcx-field-error mt-1"></span>
                </div>

                <div>
                    <label asp-for="NewItem.Summary" class="dcx-label mb-2"></label>
                    <input asp-for="NewItem.Summary" class="dcx-input" placeholder="Short description for the dashboard card..." />
                </div>

                <div>
                    <label asp-for="NewItem.Content" class="dcx-label mb-2"></label>
                    <textarea asp-for="NewItem.Content" rows="6" class="dcx-textarea" placeholder="Full announcement details..."></textarea>
                    <span asp-validation-for="NewItem.Content" class="dcx-field-error mt-1"></span>
                </div>

                <div>
                    <label asp-for="NewItem.ExpirationDate" class="dcx-label mb-2">Expiration Date (Optional)</label>
                    <input asp-for="NewItem.ExpirationDate" type="date" class="dcx-input" />
                </div>

                <div class="dcx-admin-check">
                    <label class="dcx-admin-check__label">
                        <input asp-for="NewItem.IsPinned" class="dcx-admin-check__input" />
                        <span class="dcx-admin-check__box">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        </span>
                        <span class="dcx-admin-check__text">Pin to top of Dashboard</span>
                    </label>
                </div>

                <button type="submit" class="dcx-admin-submit">Publish Announcement</button>
            </form>
        </section>

        <section class="dcx-admin-table-panel">
            <div class="dcx-admin-table-panel__head">
                <div>
                    <div class="dcx-kicker mb-2">Library</div>
                    <h2 class="dcx-section-heading mb-0">Existing announcements</h2>
                </div>

                <span class="dcx-admin-count-pill">@Model.Items.Count Total</span>
            </div>

            <div class="table-responsive">
                <table class="dcx-report-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Expires</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-white fw-bold">@item.Title</td>
                                <td>
                                    @item.PublishDateUtc.ToString("dd MMM yyyy")
                                    <div class="dcx-table-subtext">@item.PublishDateUtc.ToString("HH:mm")</div>
                                </td>
                                <td>@(item.ExpirationDate?.ToString("dd MMM yyyy") ?? "Never")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="dcx-status-pill dcx-status-pill--success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="dcx-status-pill dcx-status-pill--muted">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="dcx-admin-actions-inline">
                                        <a asp-page="/Admin/AnnouncementEdit"
                                           asp-route-id="@item.Id"
                                           class="dcx-mini-btn dcx-mini-btn--edit">
                                            Edit
                                        </a>

                                        <form method="post" asp-page-handler="ToggleActive" class="m-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="dcx-mini-btn dcx-mini-btn--neutral">
                                                @(item.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>

                                        <form method="post" asp-page-handler="Delete" class="m-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="dcx-mini-btn dcx-mini-btn--danger">
                                                Archive
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}