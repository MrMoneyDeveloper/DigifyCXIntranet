@page
@model DigifyCXIntranet.Pages.Admin.AnnouncementsModel
@{
    ViewData["Title"] = "Manage Announcements";
}

<!-- Back Button & Header -->
<div class="mx-auto max-w-7xl mt-4 mb-6 flex items-center justify-between">
    <div class="flex items-center gap-4">
        <a asp-page="/Admin/Index" class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-800 border border-slate-600 text-slate-400 hover:text-amber-400 hover:border-amber-500/50 hover:bg-slate-800/80 transition-all" title="Back to Dashboard">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        </a>
        <h1 class="text-2xl font-extrabold text-white tracking-tight">Manage Announcements</h1>
    </div>
</div>

<div class="mx-auto max-w-7xl grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- ================= LEFT COLUMN: FORM ================= -->
    <div class="lg:col-span-5">
        <section class="bg-[#1e2336] rounded-2xl p-6 lg:p-8 border border-slate-700 shadow-xl sticky top-6">
            <div class="flex items-center gap-3 mb-6 border-b border-slate-700/80 pb-4">
                <svg class="h-5 w-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
                <h2 class="text-lg font-bold text-white">Create Announcement</h2>
            </div>
            
            <form method="post" asp-page-handler="Create" class="flex flex-col gap-5">
                
                <!-- Title -->
                <div>
                    <label asp-for="NewItem.Title" class="block text-sm font-semibold text-slate-300 mb-1.5"></label>
                    <input asp-for="NewItem.Title" class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500 transition" placeholder="e.g., Monthly Townhall" />
                    <span asp-validation-for="NewItem.Title" class="text-xs font-medium text-rose-400 mt-1 block"></span>
                </div>
                
                <!-- Summary -->
                <div>
                    <label asp-for="NewItem.Summary" class="block text-sm font-semibold text-slate-300 mb-1.5"></label>
                    <input asp-for="NewItem.Summary" class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500 transition" placeholder="Short description for the dashboard card..." />
                </div>
                
                <!-- Content -->
                <div>
                    <label asp-for="NewItem.Content" class="block text-sm font-semibold text-slate-300 mb-1.5"></label>
                    <textarea asp-for="NewItem.Content" rows="6" class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500 transition" placeholder="Full announcement details..."></textarea>
                    <span asp-validation-for="NewItem.Content" class="text-xs font-medium text-rose-400 mt-1 block"></span>
                </div>

                <!-- Expiration -->
                <div>
                    <label asp-for="NewItem.ExpirationDate" class="block text-sm font-semibold text-slate-300 mb-1.5">Expiration Date (Optional)</label>
                    <input asp-for="NewItem.ExpirationDate" type="date" class="w-full rounded-xl border border-slate-600 bg-slate-800/50 px-4 py-2.5 text-sm text-white focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500 transition [color-scheme:dark]" />
                </div>
                
                <!-- IsPinned Custom Checkbox -->
                <div class="pt-1 pb-2">
                    <label class="flex items-center gap-3 cursor-pointer group w-fit">
                        <div class="relative flex items-center">
                            <input asp-for="NewItem.IsPinned" class="peer h-5 w-5 cursor-pointer appearance-none rounded border border-slate-500 bg-slate-800/50 checked:border-amber-500 checked:bg-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/30 transition-all" />
                            <svg class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-3.5 w-3.5 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <span class="text-sm font-semibold text-slate-300 group-hover:text-white transition-colors">Pin to top of Dashboard</span>
                    </label>
                </div>
                
                <!-- Submit Button -->
                <button type="submit" class="w-full inline-flex items-center justify-center rounded-xl bg-amber-600 px-6 py-3 text-sm font-bold tracking-wide text-white shadow-md hover:bg-amber-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 transition-all duration-200">
                    Publish Announcement
                </button>
            </form>
        </section>
    </div>

    <!-- ================= RIGHT COLUMN: DATA TABLE ================= -->
    <div class="lg:col-span-7">
        <section class="bg-[#1e2336] rounded-2xl border border-slate-700 shadow-xl overflow-hidden flex flex-col h-full">
            
            <div class="p-6 lg:px-8 border-b border-slate-700 bg-slate-800/30 flex items-center justify-between">
                <h2 class="text-lg font-bold text-white">Existing Announcements</h2>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 bg-slate-800 px-3 py-1 rounded-full border border-slate-600">@Model.Items.Count Total</span>
            </div>

            <div class="overflow-x-auto flex-grow">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-900/50 text-xs uppercase text-slate-400">
                        <tr>
                            <th scope="col" class="px-6 py-4 font-semibold tracking-wider">Title</th>
                            <th scope="col" class="px-6 py-4 font-semibold tracking-wider">Date</th>
                            <th scope="col" class="px-6 py-4 font-semibold tracking-wider">Expires</th>
                            <th scope="col" class="px-6 py-4 font-semibold tracking-wider">Status</th>
                            <th scope="col" class="px-6 py-4 font-semibold tracking-wider text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700/50">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-800/40 transition-colors">
                                <td class="px-6 py-4 font-medium text-white">
                                    @item.Title
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-400 whitespace-nowrap">
                                    @item.PublishDateUtc.ToString("dd MMM yyyy")<br />
                                    <span class="text-slate-500">@item.PublishDateUtc.ToString("HH:mm")</span>
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-400 whitespace-nowrap">
                                    @(item.ExpirationDate?.ToString("dd MMM yyyy") ?? "Never")
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.IsActive)
                                    {
                                        <span class="inline-flex rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1 w-fit">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-full bg-slate-500/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1 w-fit">
                                            <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span> Inactive
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-page="/Admin/AnnouncementEdit" asp-route-id="@item.Id" title="Edit Announcement"
                                               class="inline-flex items-center justify-center rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-1.5 text-xs font-bold text-amber-400 transition hover:bg-amber-500/20 hover:border-amber-500/50">
                                            Edit
                                        </a>
                                        <form method="post" asp-page-handler="ToggleActive" class="m-0 p-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" title="@(item.IsActive ? "Deactivate" : "Activate")"
                                                    class="inline-flex items-center justify-center rounded-lg border border-slate-600 bg-slate-800 px-3 py-1.5 text-xs font-bold text-slate-300 transition hover:bg-slate-700 hover:text-white">
                                                @(item.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Delete" class="m-0 p-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" title="Archive"
                                                    class="inline-flex items-center justify-center rounded-lg border border-rose-600 bg-rose-950/40 px-3 py-1.5 text-xs font-bold text-rose-300 transition hover:bg-rose-900/60 hover:text-white">
                                                Archive
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
