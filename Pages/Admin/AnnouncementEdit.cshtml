@page "{id:int}"
@model DigifyCXIntranet.Pages.Admin.AnnouncementEditModel
@{
    ViewData["Title"] = "Edit Announcement";
}

<section class="card-elevated p-4">
    <h1 class="h5 mb-3">Edit Announcement</h1>
    <form method="post" class="row g-3">
        <input asp-for="Item.Id" type="hidden" />
        <div class="col-12">
            <label asp-for="Item.Title" class="form-label"></label>
            <input asp-for="Item.Title" class="form-control" />
            <span asp-validation-for="Item.Title" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Item.Summary" class="form-label"></label>
            <input asp-for="Item.Summary" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Item.Content" class="form-label"></label>
            <textarea asp-for="Item.Content" rows="8" class="form-control"></textarea>
            <span asp-validation-for="Item.Content" class="text-danger"></span>
        </div>
        <div class="col-sm-3">
            <div class="form-check">
                <input asp-for="Item.IsPinned" class="form-check-input" />
                <label asp-for="Item.IsPinned" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-check">
                <input asp-for="Item.IsActive" class="form-check-input" />
                <label asp-for="Item.IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="/Admin/Announcements" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
