@page
@model DigifyCXIntranet.Pages.Admin.FaqModel
@{
    ViewData["Title"] = "Manage FAQs";
}

<section class="dcx-admin-manage-shell">
    <header class="dcx-admin-manage-header">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a asp-page="/Admin/Index" class="dcx-icon-back" title="Back to Dashboard" aria-label="Back to Dashboard">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>

            <div>
                <div class="dcx-kicker mb-2">Knowledge Base</div>
                <h1 class="dcx-admin-manage-title">Manage FAQs</h1>
            </div>
        </div>
    </header>

    <div class="dcx-admin-manage-grid">
        <section class="dcx-admin-form-panel">
            <div class="dcx-admin-form-panel__head">
                <div>
                    <div class="dcx-kicker mb-2">Create</div>
                    <h2 class="dcx-section-heading mb-0">Create FAQ</h2>
                </div>
            </div>

            <form method="post" asp-page-handler="Create" class="dcx-admin-form">
                <div>
                    <label asp-for="NewItem.Category" class="dcx-label mb-2"></label>
                    <input asp-for="NewItem.Category"
                           class="dcx-input"
                           placeholder="e.g., General, Canteen, HR" />
                </div>

                <div>
                    <label asp-for="NewItem.Question" class="dcx-label mb-2"></label>
                    <input asp-for="NewItem.Question"
                           class="dcx-input"
                           placeholder="What is the policy on..." />
                    <span asp-validation-for="NewItem.Question" class="dcx-field-error mt-1"></span>
                </div>

                <div>
                    <label asp-for="NewItem.Answer" class="dcx-label mb-2"></label>
                    <textarea asp-for="NewItem.Answer"
                              rows="6"
                              class="dcx-textarea"
                              placeholder="Provide the answer here..."></textarea>
                    <span asp-validation-for="NewItem.Answer" class="dcx-field-error mt-1"></span>
                </div>

                <div>
                    <label asp-for="NewItem.DisplayOrder" class="dcx-label mb-2">Display Order (Sorting)</label>
                    <input asp-for="NewItem.DisplayOrder" type="number" class="dcx-input" />
                </div>

                <button type="submit" class="dcx-admin-submit">Save FAQ</button>
            </form>
        </section>

        <section class="dcx-admin-table-panel">
            <div class="dcx-admin-table-panel__head">
                <div>
                    <div class="dcx-kicker mb-2">Library</div>
                    <h2 class="dcx-section-heading mb-0">Existing FAQs</h2>
                </div>

                <span class="dcx-admin-count-pill">@Model.TotalCount Total</span>
            </div>

            <div class="table-responsive">
                <table class="dcx-report-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Question</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="dcx-category-pill">
                                        @item.Category
                                    </span>
                                </td>
                                <td class="dcx-faq-question-cell" title="@item.Question">
                                    @item.Question
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="dcx-status-pill dcx-status-pill--success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="dcx-status-pill dcx-status-pill--muted">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="dcx-admin-actions-inline">
                                        <a asp-page="/Admin/FaqEdit"
                                           asp-route-id="@item.Id"
                                           class="dcx-mini-btn dcx-mini-btn--edit">
                                            Edit
                                        </a>

                                        <form method="post" asp-page-handler="ToggleActive" class="m-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="dcx-mini-btn dcx-mini-btn--neutral">
                                                @(item.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="new DigifyCXIntranet.Models.PaginationViewModel(Model.PageNumber, Model.PageSize, Model.TotalCount)" />
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
