@page
@model DigifyCXIntranet.Pages.Admin.CanteenModel
@{
    ViewData["Title"] = "Canteen Reporting";
}

<section class="card-elevated p-4 mb-4">
    <h1 class="h5 mb-3">Canteen Reconciliation & Job History</h1>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-sm-3">
            <label asp-for="Year" class="form-label"></label>
            <input asp-for="Year" type="number" class="form-control" />
        </div>
        <div class="col-sm-3">
            <label asp-for="Month" class="form-label"></label>
            <input asp-for="Month" type="number" min="1" max="12" class="form-control" />
        </div>
        <div class="col-sm-3">
            <button type="submit" class="btn btn-primary">Load</button>
        </div>
    </form>
</section>

<div class="row g-4">
    <div class="col-lg-4">
        <section class="card-elevated p-4 mb-4">
            <h2 class="h6 mb-3">Employee Monthly Tallies</h2>
            @if (Model.Tallies.Count == 0)
            {
                <p class="text-muted mb-0">No orders found for this period.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>Employee</th><th>Count</th><th>Total</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Tallies)
                    {
                        <tr><td>@item.EmployeeUsername</td><td>@item.Count</td><td>R @item.TotalAmount.ToString("N2")</td></tr>
                    }
                    </tbody>
                </table>
            }
        </section>
    </div>

    <div class="col-lg-8">
        <section class="card-elevated p-4 mb-4">
            <h2 class="h6 mb-3">Canteen Batch Runs</h2>
            @if (Model.BatchRuns.Count == 0)
            {
                <p class="text-muted mb-0">No batch runs yet.</p>
            }
            else
            {
                <table class="table align-middle">
                    <thead><tr><th>When</th><th>Meal</th><th>Orders</th><th>Status</th><th>Attachment</th><th>Artifact</th></tr></thead>
                    <tbody>
                    @foreach (var run in Model.BatchRuns)
                    {
                        <tr>
                            <td>@run.TriggeredUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td>@run.MealSlot</td>
                            <td>@run.OrdersCount</td>
                            <td>@(run.SentSuccessfully ? "Sent" : "Failed")</td>
                            <td>@run.AttachmentFileName</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(run.ArtifactPath))
                                {
                                    <a asp-page-handler="DownloadBatchArtifact" asp-route-id="@run.Id" class="btn btn-sm btn-outline-primary">Download</a>
                                }
                                else
                                {
                                    <span class="text-muted">SMTP/no artifact</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>

        <section class="card-elevated p-4">
            <h2 class="h6 mb-3">Order Detail</h2>
            @if (Model.Orders.Count == 0)
            {
                <p class="text-muted mb-0">No orders in this period.</p>
            }
            else
            {
                <table class="table align-middle">
                    <thead><tr><th>Employee</th><th>Time</th><th>Item</th><th>Meal</th><th>Status</th><th>Total</th></tr></thead>
                    <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.EmployeeUsername</td>
                            <td>@order.OrderTimeUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td>@order.ItemSummary</td>
                            <td>@order.MealSlot</td>
                            <td>@order.Status</td>
                            <td>R @order.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>
    </div>
</div>
