@page "{id:int}"
@model DigifyCXIntranet.Pages.Admin.FaqEditModel
@{
    ViewData["Title"] = "Edit FAQ";
}

<section class="dcx-admin-edit-shell">
    <header class="dcx-admin-manage-header">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a asp-page="/Admin/Faq" class="dcx-icon-back" title="Back to FAQs" aria-label="Back to FAQs">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>

            <div>
                <div class="dcx-kicker mb-2">Knowledge Base</div>
                <h1 class="dcx-admin-manage-title">Edit FAQ</h1>
                <p class="dcx-admin-edit-copy mb-0 mt-2">
                    Update category, question text, answer content, and sorting order.
                </p>
            </div>
        </div>
    </header>

    <section class="dcx-admin-edit-panel">
        <form method="post" class="row g-4">
            <input asp-for="Item.Id" type="hidden" />

            <div class="col-md-4">
                <label asp-for="Item.Category" class="dcx-label mb-2"></label>
                <input asp-for="Item.Category" class="dcx-input" />
            </div>

            <div class="col-md-8">
                <label asp-for="Item.Question" class="dcx-label mb-2"></label>
                <input asp-for="Item.Question" class="dcx-input" />
                <span asp-validation-for="Item.Question" class="dcx-field-error mt-1"></span>
            </div>

            <div class="col-12">
                <label asp-for="Item.Answer" class="dcx-label mb-2"></label>
                <textarea asp-for="Item.Answer" rows="8" class="dcx-textarea"></textarea>
                <span asp-validation-for="Item.Answer" class="dcx-field-error mt-1"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Item.DisplayOrder" class="dcx-label mb-2">Display Order (Sorting)</label>
                <input asp-for="Item.DisplayOrder" type="number" class="dcx-input" />
            </div>

            <div class="col-md-6 d-flex align-items-center">
                <label class="dcx-admin-check__label">
                    <input asp-for="Item.IsActive" class="dcx-admin-check__input" />
                    <span class="dcx-admin-check__box">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </span>
                    <span class="dcx-admin-check__text">FAQ is Active</span>
                </label>
            </div>

            <div class="col-12">
                <div class="dcx-admin-edit-actions">
                    <button type="submit" class="dcx-admin-submit">Save Changes</button>
                    <a asp-page="/Admin/Faq" class="dcx-btn-ghost">Cancel</a>
                </div>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}