@page "{id:int}"
@model DigifyCXIntranet.Pages.Admin.FaqEditModel
@{
    ViewData["Title"] = "Edit FAQ";
}

<section class="card-elevated p-4">
    <h1 class="h5 mb-3">Edit FAQ</h1>
    <form method="post" class="row g-3">
        <input asp-for="Item.Id" type="hidden" />
        <div class="col-md-4">
            <label asp-for="Item.Category" class="form-label"></label>
            <input asp-for="Item.Category" class="form-control" />
        </div>
        <div class="col-md-8">
            <label asp-for="Item.Question" class="form-label"></label>
            <input asp-for="Item.Question" class="form-control" />
            <span asp-validation-for="Item.Question" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Item.Answer" class="form-label"></label>
            <textarea asp-for="Item.Answer" rows="8" class="form-control"></textarea>
            <span asp-validation-for="Item.Answer" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Item.DisplayOrder" class="form-label"></label>
            <input asp-for="Item.DisplayOrder" type="number" class="form-control" />
        </div>
        <div class="col-md-4 align-self-end">
            <div class="form-check">
                <input asp-for="Item.IsActive" class="form-check-input" />
                <label asp-for="Item.IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="/Admin/Faq" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
