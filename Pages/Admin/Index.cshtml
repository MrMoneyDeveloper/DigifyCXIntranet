@page
@model DigifyCXIntranet.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Console";
}

<section class="dcx-admin-hero mb-4">
    <div class="dcx-admin-hero__content">
        <div>
            <div class="dcx-kicker mb-3">Admin Console</div>
            <h1 class="dcx-admin-title">Operational control for the <span>DigifyCX intranet</span></h1>
            <p class="dcx-admin-copy mt-3 mb-0">
                Control publishing, canteen automation inputs, user access, and operational reporting from one place.
            </p>
        </div>

        <img src="~/images/branding/digifycx-logo.png"
             alt=""
             aria-hidden="true"
             class="dcx-admin-watermark" />
    </div>
</section>

<section class="dcx-admin-kpis mb-4">
    <article class="dcx-admin-kpi">
        <div class="dcx-admin-kpi__label">Policies</div>
        <div class="dcx-admin-kpi__value">@Model.PolicyCount</div>
    </article>

    <article class="dcx-admin-kpi">
        <div class="dcx-admin-kpi__label">Announcements</div>
        <div class="dcx-admin-kpi__value">@Model.AnnouncementCount</div>
    </article>

    <article class="dcx-admin-kpi">
        <div class="dcx-admin-kpi__label">Jobs</div>
        <div class="dcx-admin-kpi__value">@Model.JobCount</div>
    </article>

    <article class="dcx-admin-kpi">
        <div class="dcx-admin-kpi__label">FAQs</div>
        <div class="dcx-admin-kpi__value">@Model.FaqCount</div>
    </article>

    <article class="dcx-admin-kpi">
        <div class="dcx-admin-kpi__label">Canteen orders</div>
        <div class="dcx-admin-kpi__value">@Model.CanteenOrderCount</div>
    </article>

    <article class="dcx-admin-kpi">
        <div class="dcx-admin-kpi__label">Menu items</div>
        <div class="dcx-admin-kpi__value">@Model.MenuItemCount</div>
    </article>

    <article class="dcx-admin-kpi">
        <div class="dcx-admin-kpi__label">Batch runs</div>
        <div class="dcx-admin-kpi__value">@Model.BatchRunCount</div>
    </article>
</section>

<section class="dcx-admin-actions">
    <div class="mb-3">
        <div class="dcx-kicker mb-2">Actions</div>
        <h2 class="dcx-section-heading mb-0">Management areas</h2>
    </div>

    <div class="dcx-admin-actions__grid">
        @if (Model.CanManageCanteen)
        {
            <a asp-page="/Admin/Menu" class="dcx-admin-action">
                <span class="dcx-admin-action__title">Manage Canteen Menu</span>
                <span class="dcx-admin-action__meta">Update available items and meal options.</span>
            </a>

            <a asp-page="/Admin/Canteen" class="dcx-admin-action">
                <span class="dcx-admin-action__title">Canteen Operations</span>
                <span class="dcx-admin-action__meta">Monitor canteen processes and activity.</span>
            </a>
        }

        @if (Model.CanViewFinance)
        {
            <a asp-page="/Finance/CanteenLedger" class="dcx-admin-action">
                <span class="dcx-admin-action__title">Finance Ledger</span>
                <span class="dcx-admin-action__meta">Review ledger activity and canteen costs.</span>
            </a>
        }

        @if (Model.CanManageHr)
        {
            <a asp-page="/Admin/Policies" class="dcx-admin-action">
                <span class="dcx-admin-action__title">Manage Policies</span>
                <span class="dcx-admin-action__meta">Publish and maintain policy content.</span>
            </a>

            <a asp-page="/Admin/Jobs" class="dcx-admin-action">
                <span class="dcx-admin-action__title">Manage Jobs</span>
                <span class="dcx-admin-action__meta">Post and maintain internal opportunities.</span>
            </a>
        }

        @if (Model.CanManageSystem)
        {
            <a asp-page="/Admin/Operations" class="dcx-admin-action">
                <span class="dcx-admin-action__title">System Operations</span>
                <span class="dcx-admin-action__meta">Review job schedules, outcomes, retries, and email queues.</span>
            </a>

            <a asp-page="/Admin/Faq" class="dcx-admin-action">
                <span class="dcx-admin-action__title">Manage FAQs</span>
                <span class="dcx-admin-action__meta">Maintain help content for employees.</span>
            </a>
        }

        @if (Model.CanManageAnnouncements)
        {
            <a asp-page="/Admin/Announcements" class="dcx-admin-action">
                <span class="dcx-admin-action__title">Manage Announcements</span>
                <span class="dcx-admin-action__meta">Publish business notices and updates.</span>
            </a>
        }

        @if (Model.CanManageUsers)
        {
            <a asp-page="/Admin/Users" class="dcx-admin-action">
                <span class="dcx-admin-action__title">Manage Users</span>
                <span class="dcx-admin-action__meta">Control user access and administration.</span>
            </a>
        }
    </div>
</section>
