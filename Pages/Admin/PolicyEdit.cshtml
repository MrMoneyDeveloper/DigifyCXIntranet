@page "{id:int}"
@model DigifyCXIntranet.Pages.Admin.PolicyEditModel
@{
    ViewData["Title"] = "Edit Policy";
}

<section class="dcx-admin-edit-shell">
    <header class="dcx-admin-manage-header">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a asp-page="/Admin/Policies" class="dcx-icon-back" title="Back to Policies" aria-label="Back to Policies">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>

            <div>
                <div class="dcx-kicker mb-2">Policy Library</div>
                <h1 class="dcx-admin-manage-title">Edit document</h1>
                <p class="dcx-admin-edit-copy mb-0 mt-2">
                    Update policy details, content, and visibility.
                </p>
            </div>
        </div>
    </header>

    <section class="dcx-admin-edit-panel">
        <form method="post" class="row g-4">
            <input asp-for="Item.Id" type="hidden" />

            <div class="col-md-6">
                <label asp-for="Item.Title" class="dcx-label mb-2"></label>
                <input asp-for="Item.Title" class="dcx-input" />
                <span asp-validation-for="Item.Title" class="dcx-field-error mt-1"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Item.ContentType" class="dcx-label mb-2"></label>
                <select asp-for="Item.ContentType"
                        asp-items="Html.GetEnumSelectList<DigifyCXIntranet.Models.PolicyContentType>()"
                        class="dcx-input dcx-input-select"></select>
            </div>

            <div class="col-md-3">
                <label asp-for="Item.VersionLabel" class="dcx-label mb-2"></label>
                <input asp-for="Item.VersionLabel" class="dcx-input" />
            </div>

            <div class="col-md-6">
                <label asp-for="Item.EffectiveDate" class="dcx-label mb-2"></label>
                <input asp-for="Item.EffectiveDate" type="date" class="dcx-input" />
            </div>

            <div class="col-md-6 d-flex align-items-center">
                <label class="dcx-admin-check__label">
                    <input asp-for="Item.IsActive" class="dcx-admin-check__input" />
                    <span class="dcx-admin-check__box">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </span>
                    <span class="dcx-admin-check__text">Document is Active and Visible</span>
                </label>
            </div>

            <div class="col-12">
                <label asp-for="Item.Content" class="dcx-label mb-2"></label>
                <textarea asp-for="Item.Content" rows="12" class="dcx-textarea dcx-policy-editor"></textarea>
                <span asp-validation-for="Item.Content" class="dcx-field-error mt-1"></span>
            </div>

            <div class="col-12">
                <div class="dcx-admin-edit-actions">
                    <button type="submit" class="dcx-admin-submit">Save Changes</button>
                    <a asp-page="/Admin/Policies" class="dcx-btn-ghost">Cancel</a>
                </div>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}