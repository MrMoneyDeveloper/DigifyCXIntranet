@page "{id:int}"
@model DigifyCXIntranet.Pages.Admin.PolicyEditModel
@{
    ViewData["Title"] = "Edit Policy";
}

<section class="card-elevated p-4">
    <h1 class="h5 mb-3">Edit Policy / Procedure</h1>
    <form method="post" class="row g-3">
        <input asp-for="Item.Id" type="hidden" />
        <div class="col-md-6">
            <label asp-for="Item.Title" class="form-label"></label>
            <input asp-for="Item.Title" class="form-control" />
            <span asp-validation-for="Item.Title" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Item.ContentType" class="form-label"></label>
            <select asp-for="Item.ContentType" class="form-select" asp-items="Html.GetEnumSelectList<DigifyCXIntranet.Models.PolicyContentType>()"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="Item.VersionLabel" class="form-label"></label>
            <input asp-for="Item.VersionLabel" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Item.EffectiveDate" class="form-label"></label>
            <input asp-for="Item.EffectiveDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4 align-self-end">
            <div class="form-check">
                <input asp-for="Item.IsActive" class="form-check-input" />
                <label asp-for="Item.IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12">
            <label asp-for="Item.Content" class="form-label"></label>
            <textarea asp-for="Item.Content" rows="10" class="form-control"></textarea>
            <span asp-validation-for="Item.Content" class="text-danger"></span>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="/Admin/Policies" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
