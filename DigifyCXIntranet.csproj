<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-DigifyCXIntranet-afd7063a-9dda-4b3f-b6e5-53138f851079</UserSecretsId>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.1.973" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.29" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.1" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="3.13.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src\**\*.cs;tests\**\*.cs" />
    <Content Remove="src\**\*;tests\**\*" />
    <EmbeddedResource Remove="src\**\*;tests\**\*" />
    <None Remove="src\**\*;tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="packages\**\*.cs" />
    <Content Remove="packages\**\*" />
    <EmbeddedResource Remove="packages\**\*" />
    <None Remove="packages\**\*" />
    <Content Remove="artifacts\**\*;deploy\**\*;App_Data\Outbox\**\*;App_Data\DataProtection-Keys\**\*;wwwroot\uploads\**\*;nuget.config" />
    <None Remove="artifacts\**\*;deploy\**\*;App_Data\Outbox\**\*;App_Data\DataProtection-Keys\**\*;wwwroot\uploads\**\*;nuget.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json;tailwind.config.js;wwwroot\package-lock.json;wwwroot\css\tailwind.input.css" />
    <None Remove="package.json;package-lock.json;tailwind.config.js;wwwroot\package-lock.json;wwwroot\css\tailwind.input.css" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs;App_Data\Outbox\**\*.cs;App_Data\DataProtection-Keys\**\*.cs" />
    <Content Remove="artifacts\**\*;App_Data\Outbox\**\*;App_Data\DataProtection-Keys\**\*;wwwroot\uploads\**\*" />
    <EmbeddedResource Remove="artifacts\**\*;App_Data\Outbox\**\*;App_Data\DataProtection-Keys\**\*" />
    <None Remove="artifacts\**\*;App_Data\Outbox\**\*;App_Data\DataProtection-Keys\**\*;wwwroot\uploads\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="appsettings.Development.json;appsettings.Test.json;appsettings.Production.json;appsettings.*.local.json;appsettings.*.example.json;*.secrets.json" />
    <None Remove="appsettings.Development.json;appsettings.Test.json;appsettings.Production.json;appsettings.*.local.json;appsettings.*.example.json;*.secrets.json" />
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Test.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Production.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.*.local.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.*.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="*.secrets.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <None Include="appsettings.Development.json;appsettings.Test.json;appsettings.Production.json;appsettings.*.local.json;appsettings.*.example.json;*.secrets.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
